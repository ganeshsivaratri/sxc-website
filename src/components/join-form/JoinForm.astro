<section class="join-section" id="join-form">
  <div class="join-heading">
    <span class="eyebrow">JOIN SINTRAX CREATIONS</span>

    <h1>
      Be part of
      <span>SintraX Creations.</span>
    </h1>

    <p>
      Tell us about yourself, your interests, and what you would like to
      build. Our team will contact you through WhatsApp to discuss the next
      steps.
    </p>
  </div>

  <form id="sxc-registration-form" class="registration-form">
    <div class="form-header">
      <span class="form-number">SXC — PILOT LAUNCH 01</span>
      <h2>Student Registration</h2>
      <p>
        45 Days · One Team · One Project
      </p>
      <small>
        Please provide accurate information so our team can understand your
        background, interests, and availability.
      </small>
    </div>

    <!-- Personal Information -->
    <div class="form-group">
      <div class="section-title">
        <span>01</span>
        <div>
          <h3>Personal Information</h3>
          <p>Tell us a little about yourself.</p>
        </div>
      </div>

      <label>
        Full Name <b>*</b>
        <input type="text" name="Full Name" required placeholder="Enter your full name" />
      </label>

      <label>
        Email <b>*</b>
        <input type="email" name="Email" required placeholder="Enter your email address" />
      </label>

      <label>
        Branch / Department & Section <b>*</b>
        <input
          type="text"
          name="Branch / Department & Section"
          required
          placeholder="Example: CSE - A"
        />
      </label>

      <label>
        College / Institution Name <b>*</b>
        <input
          type="text"
          name="College / Institution Name"
          required
          placeholder="Enter your college name"
        />
      </label>

      <label>
        Register / Roll Number <b>*</b>
        <input
          type="text"
          name="Register / Roll Number"
          required
          placeholder="Enter your register or roll number"
        />
      </label>

      <fieldset>
        <legend>Current Year of Study <b>*</b></legend>

        <label class="option">
          <input type="radio" name="Current Year of Study" value="1st Year" required />
          1st Year
        </label>

        <label class="option">
          <input type="radio" name="Current Year of Study" value="2nd Year" />
          2nd Year
        </label>

        <label class="option">
          <input type="radio" name="Current Year of Study" value="3rd Year" />
          3rd Year
        </label>

        <label class="option">
          <input type="radio" name="Current Year of Study" value="4th Year" />
          4th Year
        </label>
      </fieldset>

      <label>
        Active WhatsApp Number <b>*</b>
        <input
          type="tel"
          name="Active WhatsApp Number"
          required
          placeholder="Enter your WhatsApp number"
        />
      </label>
    </div>

    <!-- Guardian Information -->
    <div class="form-group">
      <div class="section-title">
        <span>02</span>
        <div>
          <h3>Guardian Information</h3>
          <p>This information is used only for registration and communication.</p>
        </div>
      </div>

      <label>
        Guardian Full Name <b>*</b>
        <input
          type="text"
          name="Guardian Full Name"
          required
          placeholder="Enter guardian's full name"
        />
      </label>

      <label>
        Guardian Mobile Number <b>*</b>
        <input
          type="tel"
          name="Guardian Mobile Number"
          required
          placeholder="Enter guardian's mobile number"
        />
      </label>

      <label>
        Guardian Occupation
        <input
          type="text"
          name="Guardian Occupation"
          placeholder="Enter guardian's occupation"
        />
      </label>

      <p class="privacy-note">
        <strong>Privacy Note:</strong>
        Guardian information is collected only for SXC registration, student
        communication, project/program management, and related operational
        purposes. This information will be kept confidential and will not be
        intentionally shared with third parties.
      </p>
    </div>

    <!-- Academic Information -->
    <div class="form-group">
      <div class="section-title">
        <span>03</span>
        <div>
          <h3>Academic Information</h3>
          <p>Help us understand your academic background.</p>
        </div>
      </div>

      <label>
        Previous Academic Percentage <b>*</b>
        <input
          type="text"
          name="Previous Academic Percentage"
          required
          placeholder="Enter your previous academic percentage"
        />
      </label>

      <label>
        Current CGPA / Percentage
        <input
          type="text"
          name="Current CGPA / Percentage"
          placeholder="Enter your current CGPA or percentage"
        />
      </label>
    </div>

    <!-- Goals and Interests -->
    <div class="form-group">
      <div class="section-title">
        <span>04</span>
        <div>
          <h3>Goals & Interests</h3>
          <p>Tell us about your interests and future goals.</p>
        </div>
      </div>

      <fieldset>
        <legend>What is your main career goal? <b>*</b></legend>

        {
          [
            "Software Developer / Engineer",
            "Startup Founder / Entrepreneur",
            "Government / Competitive Exams",
            "AI / Machine Learning",
            "Higher Studies",
            "Business / Management",
          ].map((item) => (
            <label class="option">
              <input type="checkbox" name="Main Career Goal" value={item} />
              {item}
            </label>
          ))
        }
      </fieldset>

      <fieldset>
        <legend>
          Are you interested in building your own projects or startup ideas? <b>*</b>
        </legend>

        {
          [
            "Yes",
            "Yes, but I don't know how to start",
            "No",
            "Maybe",
          ].map((item) => (
            <label class="option">
              <input
                type="radio"
                name="Interest in Building Projects or Startup Ideas"
                value={item}
                required
              />
              {item}
            </label>
          ))
        }
      </fieldset>

      <fieldset>
        <legend>What areas are you most interested in? <b>*</b></legend>

        {
          [
            "Web Development",
            "Mobile Apps",
            "Artificial Intelligence",
            "Cybersecurity",
            "Data Science",
            "UI/UX Design",
            "Business / Startups",
            "Content / Marketing",
            "Other",
          ].map((item) => (
            <label class="option">
              <input type="checkbox" name="Areas of Interest" value={item} />
              {item}
            </label>
          ))
        }
      </fieldset>

      <label>
        Describe what you want to achieve during the next few years. <b>*</b>
        <textarea
          name="Future Goals"
          required
          rows="5"
          placeholder="Tell us about your goals..."
        ></textarea>
      </label>
    </div>

    <!-- Projects and Commitment -->
    <div class="form-group">
      <div class="section-title">
        <span>05</span>
        <div>
          <h3>Projects & Commitment</h3>
          <p>Understand the type of work you would like to contribute to.</p>
        </div>
      </div>

      <p class="info-box">
        We are looking for students interested in building real projects and
        exploring startup ideas as a team. No existing coding skills are
        compulsory. Consistency, curiosity, teamwork, and willingness to learn
        are also valuable.
      </p>

      <fieldset>
        <legend>Are you interested in working on real projects or startup ideas? <b>*</b></legend>

        {
          [
            "Yes, definitely",
            "Yes, I want to know more",
            "Maybe",
            "Not currently",
          ].map((item) => (
            <label class="option">
              <input
                type="radio"
                name="Interest in Real Projects or Startup Ideas"
                value={item}
                required
              />
              {item}
            </label>
          ))
        }
      </fieldset>

      <label>
        Do you have a project idea you would like to propose?
        <textarea
          name="Proposed Project Idea"
          rows="4"
          placeholder="Describe your idea, if you have one..."
        ></textarea>
      </label>

      <fieldset>
        <legend>How much time can you commit to SXC each day? <b>*</b></legend>

        {
          [
            "Less than 1 hour",
            "1–2 hours",
            "2–3 hours",
            "More than 3 hours",
          ].map((item) => (
            <label class="option">
              <input
                type="radio"
                name="Daily Time Commitment"
                value={item}
                required
              />
              {item}
            </label>
          ))
        }
      </fieldset>

      <fieldset>
        <legend>Which areas would you like to contribute to in a project? <b>*</b></legend>

        {
          [
            "Project development",
            "Research and ideas",
            "Planning and management",
            "Marketing and promotion",
            "Content creation",
            "Design",
            "Team coordination",
            "Development",
            "Other",
          ].map((item) => (
            <label class="option">
              <input
                type="radio"
                name="Preferred Contribution Area"
                value={item}
                required
              />
              {item}
            </label>
          ))
        }
      </fieldset>

      <label>
        Why do you want to participate in SXC? <b>*</b>
        <textarea
          name="Reason for Participating in SXC"
          required
          rows="5"
          placeholder="Tell us why you are interested..."
        ></textarea>
      </label>
    </div>

    <!-- Skills and Experience -->
    <div class="form-group">
      <div class="section-title">
        <span>06</span>
        <div>
          <h3>Skills & Experience</h3>
          <p>No existing technical skills are required to join.</p>
        </div>
      </div>

      <label>
        Do you currently have any skills or experience?
        <span class="field-help">
          Mention any skills such as Java, Python, C/C++, HTML, CSS, JavaScript,
          frontend, backend, AI/ML, marketing, video editing, content creation,
          research, or any other skill. If you have no skills yet, write
          “Beginner”.
        </span>

        <textarea
          name="Current Skills and Experience"
          rows="5"
          placeholder="Describe your current skills or write Beginner..."
        ></textarea>
      </label>

      <fieldset>
        <legend>What is your current skill level? <b>*</b></legend>

        {
          [
            "Complete Beginner",
            "Beginner",
            "Intermediate",
            "Advanced",
          ].map((item) => (
            <label class="option">
              <input
                type="radio"
                name="Current Skill Level"
                value={item}
                required
              />
              {item}
            </label>
          ))
        }
      </fieldset>

      <fieldset>
        <legend>Which skills would you like to learn or improve? <b>*</b></legend>

        {
          [
            "Programming",
            "Web Development",
            "AI / Artificial Intelligence",
            "Data Science",
            "UI/UX Design",
            "Cybersecurity",
            "Marketing",
            "Business / Startups",
            "Project Management",
            "Communication",
          ].map((item) => (
            <label class="option">
              <input
                type="radio"
                name="Skills to Learn or Improve"
                value={item}
                required
              />
              {item}
            </label>
          ))
        }
      </fieldset>
    </div>

    <!-- Communication -->
    <div class="form-group">
      <div class="section-title">
        <span>07</span>
        <div>
          <h3>Communication & Next Steps</h3>
          <p>Help us understand how to contact you.</p>
        </div>
      </div>

      <fieldset>
        <legend>How would you prefer to communicate with us? <b>*</b></legend>

        <label class="option">
          <input type="radio" name="Preferred Communication" value="Phone Call" required />
          Phone Call
        </label>

        <label class="option">
          <input type="radio" name="Preferred Communication" value="WhatsApp Chat" />
          WhatsApp Chat
        </label>
      </fieldset>

      <fieldset>
        <legend>Are you available for a short one-to-one discussion if required? <b>*</b></legend>

        <label class="option">
          <input type="radio" name="One-to-One Discussion Availability" value="Yes" required />
          Yes
        </label>

        <label class="option">
          <input
            type="radio"
            name="One-to-One Discussion Availability"
            value="Maybe, depending on schedule"
          />
          Maybe, depending on schedule
        </label>

        <label class="option">
          <input type="radio" name="One-to-One Discussion Availability" value="No" />
          No
        </label>
      </fieldset>
    </div>

    <!-- Declaration -->
    <div class="form-group">
      <div class="section-title">
        <span>08</span>
        <div>
          <h3>Declaration & Consent</h3>
          <p>Please review the following information carefully.</p>
        </div>
      </div>

      <p class="info-box">
        By submitting this form, you confirm that the information provided is
        correct to the best of your knowledge.
        <br /><br />
        The information collected will be used for SintraX Creations student
        registration, student community coordination, projects, opportunities,
        and related communication. Your information will not be intentionally
        misused or sold to third parties.
        <br /><br />
        Submitting this form does not guarantee selection, project
        participation, earnings, or any other opportunity.
      </p>

      <fieldset>
        <legend>How did you hear about SXC? <b>*</b></legend>

        {
          [
            "Friend / Student",
            "College / Campus",
            "WhatsApp",
            "Instagram",
            "LinkedIn",
          ].map((item) => (
            <label class="option">
              <input
                type="radio"
                name="How They Heard About SXC"
                value={item}
                required
              />
              {item}
            </label>
          ))
        }
      </fieldset>

      <label class="consent-option">
        <input type="checkbox" name="Information Accuracy Confirmation" value="Confirmed" required />
        I confirm that the information provided by me is correct.
      </label>

      <label class="consent-option">
        <input type="checkbox" name="Communication Consent" value="Agreed" required />
        I agree to be contacted by SintraX Creations regarding projects,
        opportunities, meetings, and community activities.
      </label>

      <label class="consent-option">
        <input type="checkbox" name="SXC Declaration" value="Accepted" required />
        I confirm that the information provided is accurate and agree to
        participate in the SXC program and follow the applicable guidelines.
      </label>
    </div>

    <button type="submit" class="submit-button">
      Submit & Continue to WhatsApp
      <span>↗</span>
    </button>

    <p class="form-footer">
      Your information will be shared with the SXC team through WhatsApp for
      registration discussion and next steps.
    </p>

    <p id="form-error" class="form-error" role="alert"></p>
  </form>
</section>

<script>
  const form = document.querySelector("#sxc-registration-form");
  const errorMessage = document.querySelector("#form-error");

  /*
   * Replace this placeholder with the official SXC WhatsApp number.
   * Use the country code without + or spaces.
   * Example: 919876543210
   */
  const whatsappNumber = "91XXXXXXXXXX";

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!(form instanceof HTMLFormElement)) return;

    if (whatsappNumber.includes("X")) {
      if (errorMessage) {
        errorMessage.textContent =
          "The SXC WhatsApp number has not been configured yet.";
      }
      return;
    }

    const formData = new FormData(form);
    const groupedData = new Map<string, string[]>();

    formData.forEach((value, key) => {
      const textValue = String(value).trim();

      if (!textValue) return;

      if (!groupedData.has(key)) {
        groupedData.set(key, []);
      }

      groupedData.get(key)?.push(textValue);
    });

    let message =
      "Hello SintraX Creations,%0A%0A" +
      "I am interested in joining the SXC 45-Day Project Building Program.%0A%0A" +
      "Here are my registration details:%0A%0A";

    groupedData.forEach((values, key) => {
      message += `*${key}:* ${values.join(", ")}%0A`;
    });

    message +=
      "%0AI would like to discuss the program, selection process, and payment process.%0A%0A" +
      "Thank you.";

    const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${message}`;

    window.location.href = whatsappUrl;
  });
</script>

