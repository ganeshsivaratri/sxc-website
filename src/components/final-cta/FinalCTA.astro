  .experience-node small {
    display: block;
  }


  .experience-node strong {
    font-size: 8px;
    letter-spacing: 0.1em;
  }


  .experience-node small {
    color: #777e89;
    font-size: 7px;
    letter-spacing: 0.08em;
    margin-top: 3px;
  }


  .node-team {
    top: 28px;
    left: 8%;
  }


  .node-project {
    top: 46%;
    right: 0;
  }


  .node-skill {
    bottom: 35px;
    left: 17%;
  }


  .node-problem {
    bottom: 20%;
    right: 10%;
  }


  .experience-footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid rgba(255, 255, 255, 0.11);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
  }


  .footer-mini {
    display: block;
    color: #717782;
    font-size: 8px;
    letter-spacing: 0.16em;
    margin-bottom: 8px;
  }


  .footer-statement strong {
    font-size: 14px;
    font-weight: 500;
    color: #c8cbd0;
  }


  .footer-statement em {
    color: #fff;
    font-style: normal;
  }


  .footer-arrow {
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #9db1ff;
  }


  /* =========================================================
     DUAL CARDS
  ========================================================= */

  .sxc-dual-grid {
    display: grid;
    grid-template-columns: 0.86fr 1.14fr;
    gap: 24px;
    margin-top: 24px;
  }


  .sxc-card {
    position: relative;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(12, 13, 16, 0.11);
    border-radius: 26px;
    padding: 30px;
    box-shadow: 0 20px 55px rgba(12, 13, 16, 0.045);
  }


  .sxc-card .feature-index {
    color: #111317;
    border-color: rgba(12, 13, 16, 0.13);
  }


  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }


  .card-arrow {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(12, 13, 16, 0.12);
    border-radius: 50%;
    font-size: 13px;
    transition: transform 0.3s ease;
  }


  .sxc-card:hover .card-arrow {
    transform: translate(3px, -3px);
  }


  .certificate-heading,
  .portfolio-heading {
    margin-top: 48px;
  }


  .certificate-heading span,
  .portfolio-heading span {
    display: block;
    color: #858991;
    font-size: 12px;
    letter-spacing: 0.08em;
  }


  .certificate-heading strong,
  .portfolio-heading strong {
    display: block;
    margin-top: 4px;
    font-size: clamp(32px, 3vw, 48px);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }


  /* =========================================================
     CERTIFICATE
  ========================================================= */

  .certificate-visual {
    margin: 42px auto 30px;
    perspective: 1000px;
  }


  .certificate-paper {
    position: relative;
    width: min(100%, 440px);
    aspect-ratio: 1.42 / 1;
    margin: auto;
    padding: 20px;
    background:
      linear-gradient(
        135deg,
        #f8f8f6,
        #ffffff
      );
    border: 1px solid #d9d9d5;
    box-shadow:
      0 25px 45px rgba(12, 13, 16, 0.12);
    transform: rotate(-1deg);
    transition: transform 0.45s ease;
  }


  .certificate-card:hover .certificate-paper {
    transform: rotate(0deg) translateY(-4px);
  }


  .certificate-paper::before {
    content: "";
    position: absolute;
    inset: 9px;
    border: 1px solid #deded8;
    pointer-events: none;
  }


  .certificate-topline {
    display: flex;
    justify-content: space-between;
    position: relative;
    z-index: 2;
    font-size: 7px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }


  .certificate-seal {
    position: absolute;
    right: 34px;
    top: 52px;
    width: 48px;
    height: 48px;
    border: 1px solid #15171b;
    border-radius: 50%;
    display: grid;
    place-items: center;
    align-content: center;
    z-index: 2;
  }


  .certificate-seal span {
    font-size: 9px;
    font-weight: 800;
  }


  .certificate-seal small {
    font-size: 4px;
    letter-spacing: 0.12em;
  }


  .certificate-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }


  .certificate-content > small {
    font-size: 6px;
    letter-spacing: 0.2em;
    color: #7b7d81;
  }


  .certificate-content h3 {
    margin: 9px 0 15px;
    font-size: 22px;
    letter-spacing: 0.08em;
  }


  .certificate-name {
    padding-bottom: 6px;
    min-width: 150px;
    border-bottom: 1px solid #17181b;
    font-size: 9px;
    letter-spacing: 0.15em;
  }


  .certificate-content p {
    max-width: 190px;
    margin: 10px 0 0;
    color: #74767b;
    font-size: 6px;
    line-height: 1.5;
  }


  .certificate-bottom {
    position: absolute;
    bottom: 25px;
    left: 28px;
    right: 28px;
    display: flex;
    justify-content: space-between;
    font-size: 6px;
    z-index: 2;
  }


  .certificate-bottom span,
  .certificate-bottom small {
    display: block;
  }


  .certificate-bottom small {
    margin-top: 4px;
    color: #85878b;
    font-size: 4px;
    letter-spacing: 0.12em;
  }


  .certificate-sign {
    text-align: right;
  }


  .certificate-copy {
    padding: 18px 0;
    border-top: 1px solid rgba(12, 13, 16, 0.1);
    border-bottom: 1px solid rgba(12, 13, 16, 0.1);
  }


  .certificate-copy p {
    margin: 0;
    color: #686c74;
    font-size: 12px;
    line-height: 1.65;
  }


  .certificate-points {
    margin-top: 20px;
  }


  .certificate-point {
    display: grid;
    grid-template-columns: 25px 1fr;
    gap: 10px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(12, 13, 16, 0.08);
  }


  .certificate-point > span {
    color: #989ba2;
    font-size: 8px;
    font-weight: 800;
  }


  .certificate-point strong {
    display: block;
    font-size: 9px;
    letter-spacing: 0.08em;
  }


  .certificate-point p {
    margin: 5px 0 0;
    color: #777b83;
    font-size: 10px;
    line-height: 1.5;
  }


  /* =========================================================
     PORTFOLIO
  ========================================================= */

  .portfolio-card {
    background:
      linear-gradient(
        145deg,
        #ffffff,
        #f3f5f8
      );
  }


  .portfolio-intro {
    max-width: 560px;
    margin: 18px 0 25px;
    color: #6d7179;
    font-size: 13px;
    line-height: 1.65;
  }


  .portfolio-browser {
    overflow: hidden;
    border: 1px solid #d5d8dd;
    background: #fff;
    border-radius: 14px;
    box-shadow:
      0 25px 60px rgba(12, 13, 16, 0.1);
    transition:
      transform 0.45s ease,
      box-shadow 0.45s ease;
  }


  .portfolio-card:hover .portfolio-browser {
    transform: translateY(-5px);
    box-shadow:
      0 35px 75px rgba(12, 13, 16, 0.14);
  }


  .browser-top {
    height: 38px;
    display: grid;
    grid-template-columns: 75px 1fr 35px;
    align-items: center;
    padding: 0 11px;
    background: #f2f3f5;
    border-bottom: 1px solid #e0e2e5;
  }


  .browser-controls {
    display: flex;
    gap: 5px;
  }


  .browser-controls span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #bfc2c7;
  }


  .browser-url {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 5px;
    width: min(100%, 270px);
    padding: 6px 10px;
    border-radius: 5px;
    background: #fff;
    color: #777b82;
    font-size: 7px;
  }


  .url-lock {
    color: #9b9ea4;
  }


  .browser-menu {
    justify-self: end;
    color: #969aa1;
    font-size: 10px;
  }


  .portfolio-site {
    min-height: 390px;
    padding: 20px;
    background: #fbfbfa;
  }


  .portfolio-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }


  .portfolio-logo {
    width: 25px;
    height: 25px;
    display: grid;
    place-items: center;
    background: #101216;
    color: #fff;
    font-size: 7px;
    font-weight: 800;
    border-radius: 5px;
  }


  .portfolio-nav-links {
    display: flex;
    gap: 17px;
    font-size: 6px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }


  .portfolio-hero {
    padding: 52px 5px 40px;
  }


  .portfolio-hero-small {
    font-size: 7px;
    color: #858990;
    letter-spacing: 0.16em;
  }


  .portfolio-hero h3 {
    margin: 9px 0 0;
    font-size: clamp(35px, 4vw, 54px);
    line-height: 0.85;
    letter-spacing: -0.07em;
  }


  .portfolio-hero h3 span {
    color: #7d94e8;
  }


  .portfolio-hero p {
    margin: 14px 0 0;
    color: #7d8189;
    font-size: 8px;
  }


  .portfolio-line {
    width: 42px;
    height: 1px;
    background: #111318;
    margin-top: 22px;
  }


  .portfolio-work {
    border-top: 1px solid #dedfe1;
    padding-top: 17px;
  }


  .portfolio-work-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }


  .portfolio-work-heading span {
    font-size: 7px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }


  .portfolio-work-heading small {
    color: #9a9da3;
    font-size: 6px;
  }


  .mini-project {
    display: grid;
    grid-template-columns: 28px 1fr 20px;
    align-items: center;
    gap: 8px;
    padding: 9px 0;
    border-bottom: 1px solid #e4e5e7;
  }


  .mini-project-number {
    color: #9b9ea5;
    font-size: 7px;
  }


  .mini-project-info strong,
  .mini-project-info span {
    display: block;
  }


  .mini-project-info strong {
    font-size: 7px;
  }


  .mini-project-info span {
    margin-top: 3px;
    color: #979aa0;
    font-size: 5px;
  }


  .mini-project > span {
    justify-self: end;
    font-size: 9px;
  }


  .portfolio-points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 25px;
    margin-top: 23px;
  }


  .portfolio-point {
    display: grid;
    grid-template-columns: 31px 1fr;
    gap: 10px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(12, 13, 16, 0.08);
  }


  .portfolio-point-icon {
    width: 25px;
    height: 25px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(12, 13, 16, 0.12);
    border-radius: 7px;
    font-size: 11px;
  }


  .portfolio-point strong {
    display: block;
    font-size: 8px;
    letter-spacing: 0.08em;
  }


  .portfolio-point p {
    margin: 5px 0 0;
    color: #767a82;
    font-size: 9px;
    line-height: 1.55;
  }


  /* =========================================================
     JOURNEY
  ========================================================= */

  .journey-section {
    margin-top: 90px;
    padding: 70px 0;
    border-top: 1px solid rgba(12, 13, 16, 0.11);
    border-bottom: 1px solid rgba(12, 13, 16, 0.11);
  }


  .journey-heading {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 50px;
    align-items: end;
  }


  .journey-heading > div > span {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: #888c94;
  }


  .journey-heading h3 {
    margin: 14px 0 0;
    max-width: 700px;
    font-size: clamp(40px, 5vw, 70px);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }


  .journey-heading h3 strong {
    display: block;
  }


  .journey-heading p {
    margin: 0;
    color: #70747c;
    font-size: 13px;
    line-height: 1.65;
  }


  .journey-track {
    display: flex;
    align-items: stretch;
    margin-top: 60px;
  }


  .journey-item {
    flex: 1;
    position: relative;
    min-width: 0;
  }


  .journey-number {
    color: #a2a5ab;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }


  .journey-icon {
    width: 44px;
    height: 44px;
    margin-top: 13px;
    display: grid;
    place-items: center;
    border: 1px solid #d5d7da;
    background: #fff;
    border-radius: 50%;
    font-size: 13px;
    transition: all 0.3s ease;
  }


  .journey-item:hover .journey-icon {
    background: #111318;
    border-color: #111318;
    color: #fff;
    transform: translateY(-4px);
  }


  .journey-content {
    margin-top: 17px;
  }


  .journey-content span {
    color: #8b8f96;
    font-size: 7px;
    letter-spacing: 0.12em;
  }


  .journey-content strong {
    display: block;
    margin-top: 4px;
    font-size: 15px;
    letter-spacing: -0.02em;
  }


  .journey-content p {
    max-width: 145px;
    margin: 6px 0 0;
    color: #777b83;
    font-size: 9px;
    line-height: 1.5;
  }


  .journey-connector {
    width: 100px;
    height: 1px;
    background: #d9dbde;
    margin-top: 65px;
    flex-shrink: 1;
  }


  /* =========================================================
     FINAL STATEMENT
  ========================================================= */

  .sxc-outcome-footer {
    display: grid;
    grid-template-columns: 170px 1fr 350px;
    gap: 40px;
    align-items: center;
    padding: 110px 0 130px;
  }


  .footer-label {
    color: #888c94;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.15em;
  }


  .footer-main {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    align-items: baseline;
    font-size: clamp(35px, 4.5vw, 65px);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }


  .footer-main span {
    color: #8b8f97;
  }


  .footer-main strong {
    color: #111318;
  }


  .footer-description p {
    margin: 0;
    color: #72767e;
    font-size: 12px;
    line-height: 1.65;
  }


  /* =========================================================
     ANIMATIONS
  ========================================================= */

  @keyframes pulseDot {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }

    50% {
      transform: scale(0.7);
      opacity: 0.55;
    }
  }


  @keyframes orbitFloat {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-7px);
    }
  }


  .node-team {
    animation: orbitFloat 5s ease-in-out infinite;
  }


  .node-project {
    animation: orbitFloat 6s ease-in-out infinite 0.7s;
  }


  .node-skill {
    animation: orbitFloat 5.5s ease-in-out infinite 1.2s;
  }


  .node-problem {
    animation: orbitFloat 6.5s ease-in-out infinite 1.7s;
  }


  /* =========================================================
     TABLET
  ========================================================= */

  @media (max-width: 1050px) {

    .sxc-container {
      width: min(100% - 42px, 900px);
    }


    .sxc-heading-wrap {
      grid-template-columns: 100px 1fr;
      gap: 35px;
    }


    .experience-layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }


    .experience-copy {
      max-width: 700px;
    }


    .experience-visual {
      height: 400px;
    }


    .sxc-dual-grid {
      grid-template-columns: 1fr;
    }


    .sxc-outcome-footer {
      grid-template-columns: 120px 1fr;
    }


    .footer-description {
      grid-column: 2;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media (max-width: 700px) {

    .sxc-outcomes {
      padding-top: 75px;
    }


    .sxc-container {
      width: calc(100% - 28px);
    }


    .sxc-section-top {
      padding-bottom: 14px;
    }


    .sxc-eyebrow,
    .sxc-section-number {
      font-size: 8px;
    }


    .sxc-heading-wrap {
      display: block;
      padding: 55px 0 65px;
    }


    .sxc-heading-side {
      flex-direction: row;
      gap: 7px;
      margin-bottom: 25px;
      font-size: 8px;
    }


    .sxc-main-heading h2 {
      font-size: clamp(52px, 17vw, 76px);
    }


    .sxc-main-heading p {
      margin-top: 30px;
      font-size: 14px;
    }


    /* FEATURE */

    .sxc-feature-card {
      padding: 20px;
      border-radius: 20px;
      min-height: auto;
    }


    .feature-top {
      align-items: flex-start;
    }


    .feature-status {
      display: none;
    }


    .feature-label {
      font-size: 8px;
    }


    .feature-index {
      width: 27px;
      height: 27px;
    }


    .experience-layout {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }


    .experience-title {
      margin-top: 35px;
      font-size: clamp(48px, 14vw, 65px);
    }


    .feature-description {
      margin: 23px 0 30px;
      font-size: 13px;
    }


    .experience-points {
      grid-template-columns: 1fr;
      gap: 0;
    }


    .experience-point {
      padding: 14px 0;
    }


    .experience-point p {
      font-size: 10px;
    }


    .experience-visual {
      height: 340px;
      margin-top: 15px;
    }


    .orbit-one {
      width: 155px;
      height: 155px;
    }


    .orbit-two {
      width: 255px;
      height: 255px;
    }


    .orbit-three {
      width: 330px;
      height: 330px;
    }


    .experience-core {
      width: 135px;
      height: 135px;
    }


    .experience-core strong {
      font-size: 22px;
    }


    .experience-node {
      transform: scale(0.82);
    }


    .node-team {
      top: 15px;
      left: -5px;
    }


    .node-project {
      top: 43%;
      right: -10px;
    }


    .node-skill {
      bottom: 12px;
      left: 5px;
    }


    .node-problem {
      bottom: 15%;
      right: -5px;
    }


    .experience-footer {
      margin-top: 10px;
    }


    .footer-statement strong {
      font-size: 11px;
    }


    /* DUAL */

    .sxc-dual-grid {
      gap: 16px;
      margin-top: 16px;
    }


    .sxc-card {
      padding: 20px;
      border-radius: 20px;
    }


    .certificate-heading,
    .portfolio-heading {
      margin-top: 35px;
    }


    .certificate-heading strong,
    .portfolio-heading strong {
      font-size: 34px;
    }


    /* CERTIFICATE */

    .certificate-visual {
      margin: 30px auto 24px;
    }


    .certificate-paper {
      width: 100%;
    }


    .certificate-copy p {
      font-size: 11px;
    }


    .certificate-point p {
      font-size: 9px;
    }


    /* PORTFOLIO */

    .portfolio-intro {
      font-size: 11px;
    }


    .portfolio-browser {
      border-radius: 10px;
    }


    .portfolio-site {
      min-height: 330px;
      padding: 14px;
    }


    .portfolio-hero {
      padding: 40px 3px 30px;
    }


    .portfolio-nav-links {
      gap: 9px;
    }


    .portfolio-points {
      grid-template-columns: 1fr;
    }


    /* JOURNEY */

    .journey-section {
      margin-top: 55px;
      padding: 55px 0;
    }


    .journey-heading {
      display: block;
    }


    .journey-heading h3 {
      font-size: 43px;
    }


    .journey-heading p {
      margin-top: 20px;
    }


    .journey-track {
      display: block;
      margin-top: 45px;
    }


    .journey-item {
      display: grid;
      grid-template-columns: 38px 48px 1fr;
      align-items: center;
      gap: 10px;
    }


    .journey-number {
      grid-column: 1;
      grid-row: 1;
    }


    .journey-icon {
      grid-column: 2;
      grid-row: 1;
      margin-top: 0;
    }


    .journey-content {
      grid-column: 3;
      grid-row: 1;
      margin-top: 0;
    }


    .journey-content p {
      max-width: none;
    }


    .journey-connector {
      width: 1px;
      height: 30px;
      margin: 0 0 0 59px;
    }


    /* FOOTER */

    .sxc-outcome-footer {
      display: block;
      padding: 75px 0 90px;
    }


    .footer-main {
      margin: 25px 0;
      font-size: 46px;
      gap: 9px;
    }


    .footer-description p {
      max-width: 500px;
      font-size: 11px;
    }

  }


  /* =========================================================
     SMALL MOBILE
  ========================================================= */

  @media (max-width: 400px) {

    .sxc-main-heading h2 {
      font-size: 49px;
    }


    .experience-title {
      font-size: 45px;
    }


    .experience-visual {
      height: 300px;
    }


    .orbit-three {
      width: 290px;
      height: 290px;
    }


    .experience-node {
