---
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-shell">

    <!-- Brand -->
    <a href="/" class="brand" aria-label="SXC Home">
      <img
        src="/images/sxc-logo.png"
        alt="SXC — SintraX Creations"
        class="brand-logo"
      />
    </a>


    <!-- Desktop Navigation -->
    <nav class="main-navigation" aria-label="Main navigation">

      <a
        href="/"
        class:list={["nav-link", { active: currentPath === "/" }]}
      >
        Home
      </a>

      <a
        href="/projects"
        class:list={["nav-link", { active: currentPath === "/projects" }]}
      >
        Projects
      </a>

      <a
        href="/benefits"
        class:list={["nav-link", { active: currentPath === "/benefits" }]}
      >
        Benefits
      </a>

      <a
        href="/pricing"
        class:list={["nav-link", { active: currentPath === "/pricing" }]}
      >
        Pricing
      </a>

      <a
        href="/join"
        class:list={["nav-link", { active: currentPath === "/join" }]}
      >
        Join Now
      </a>

    </nav>


    <!-- Header Actions -->
    <div class="header-actions">

      <div class="availability-status">
        <span class="status-dot"></span>
        <span>Open for builders</span>
      </div>


      <!-- Start Building Button -->
      <a href="/join" class="cta-button">

        <span class="cta-text">
          Start Building
        </span>

        <span class="cta-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M5 12H19M12 5L19 12L12 19"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>

      </a>

    </div>


    <!-- Mobile Menu Button -->
    <button
      class="mobile-menu-button"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span></span>
      <span></span>
    </button>

  </div>


  <!-- Mobile Navigation -->
  <nav
    id="mobile-navigation"
    class="mobile-navigation"
    aria-label="Mobile navigation"
  >

    <a
      href="/"
      class:list={{ active: currentPath === "/" }}
    >
      Home
    </a>

    <a
      href="/projects"
      class:list={{ active: currentPath === "/projects" }}
    >
      Projects
    </a>

    <a
      href="/benefits"
      class:list={{ active: currentPath === "/benefits" }}
    >
      Benefits
    </a>

    <a
      href="/pricing"
      class:list={{ active: currentPath === "/pricing" }}
    >
      Pricing
    </a>

    <a
      href="/join"
      class:list={{ active: currentPath === "/join" }}
    >
      Join Now
    </a>

  </nav>
</header>


<style>
  /* =========================================
     MAIN HEADER
  ========================================= */

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;

    width: 100%;
    padding: 18px 0;

    pointer-events: none;
  }


  .header-shell {
    position: relative;

    display: flex;
    align-items: center;

    gap: 30px;

    width: min(1280px, calc(100% - 40px));
    min-height: 66px;

    margin: 0 auto;

    padding: 9px 10px 9px 22px;

    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 18px;

    background: rgba(8, 20, 35, 0.78);

    box-shadow:
      0 12px 50px rgba(0, 0, 0, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);

    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);

    pointer-events: auto;
  }


  .header-shell::after {
    position: absolute;

    top: -1px;
    right: 18%;
    left: 18%;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(77, 228, 255, 0.7),
        transparent
      );

    content: "";

    opacity: 0.7;
  }


  /* =========================================
     BRAND LOGO
  ========================================= */

  .brand {
    display: inline-flex;

    flex-shrink: 0;

    align-items: center;

    text-decoration: none;
  }


  .brand-logo {
    display: block;

    width: 116px;
    height: auto;

    object-fit: contain;

    mix-blend-mode: screen;

    transition:
      transform 0.3s ease,
      filter 0.3s ease;
  }


  .brand:hover .brand-logo {
    transform: scale(1.04);

    filter: brightness(1.12);
  }


  /* =========================================
     DESKTOP NAVIGATION
  ========================================= */

  .main-navigation {
    display: flex;

    align-items: center;

    gap: 5px;

    margin-left: auto;
  }


  .nav-link {
    position: relative;

    padding: 11px 15px;

    border-radius: 10px;

    color: rgba(255, 255, 255, 0.64);

    font-family: Arial, Helvetica, sans-serif;

    font-size: 13px;

    font-weight: 600;

    text-decoration: none;

    transition:
      color 0.25s ease,
      background 0.25s ease;
  }


  .nav-link:hover,
  .nav-link.active {
    color: #ffffff;

    background: rgba(255, 255, 255, 0.07);
  }


  .nav-link.active::before {
    position: absolute;

    bottom: 5px;
    left: 50%;

    width: 4px;
    height: 4px;

    border-radius: 50%;

    background: #4de4ff;

    content: "";

    transform: translateX(-50%);

    box-shadow:
      0 0 10px rgba(77, 228, 255, 0.7);
  }


  /* =========================================
     HEADER ACTIONS
  ========================================= */

  .header-actions {
    display: flex;

    align-items: center;

    gap: 20px;

    margin-left: auto;
  }


  .availability-status {
    display: flex;

    align-items: center;

    gap: 8px;

    color: rgba(255, 255, 255, 0.55);

    font-family: Arial, Helvetica, sans-serif;

    font-size: 11px;

    white-space: nowrap;
  }


  .status-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #4de4ff;

    box-shadow:
      0 0 12px rgba(77, 228, 255, 0.8);

    animation:
      statusPulse 2.5s ease-in-out infinite;
  }


  /* =========================================
     START BUILDING BUTTON
  ========================================= */

  .cta-button {
    position: relative;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 18px;

    min-width: 148px;

    padding: 13px 15px 13px 19px;

    overflow: hidden;

    border: 1px solid rgba(255, 255, 255, 0.25);

    border-radius: 12px;

    background: #ffffff;

    color: #081f33;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 12px;

    font-weight: 800;

    text-decoration: none;

    white-space: nowrap;

    transition:
      transform 0.3s ease,
      background 0.3s ease,
      box-shadow 0.3s ease;
  }


  .cta-button:hover {
    background: #4de4ff;

    transform: translateY(-2px);

    box-shadow:
      0 10px 30px rgba(77, 228, 255, 0.25);
  }


  .cta-icon {
    display: flex;

    align-items: center;

    justify-content: center;

    width: 25px;
    height: 25px;

    flex-shrink: 0;

    border-radius: 8px;

    background: #081f33;

    color: #ffffff;

    transition:
      transform 0.3s ease;
  }


  .cta-icon svg {
    width: 14px;
    height: 14px;
  }


  .cta-button:hover .cta-icon {
    transform: translateX(3px);
  }


  /* =========================================
     MOBILE MENU BUTTON
  ========================================= */

  .mobile-menu-button {
    display: none;

    flex-direction: column;

    justify-content: center;

    gap: 6px;

    width: 40px;
    height: 40px;

    padding: 10px;

    border: 1px solid rgba(77, 228, 255, 0.25);

    border-radius: 10px;

    background: rgba(77, 228, 255, 0.07);

    cursor: pointer;
  }


  .mobile-menu-button span {
    display: block;

    width: 100%;
    height: 2px;

    border-radius: 10px;

    background: #ffffff;

    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }


  .mobile-menu-button[aria-expanded="true"]
    span:first-child {
    transform:
      translateY(4px)
      rotate(45deg);
  }


  .mobile-menu-button[aria-expanded="true"]
    span:last-child {
    transform:
      translateY(-4px)
      rotate(-45deg);
  }


  /* =========================================
     MOBILE NAVIGATION
  ========================================= */

  .mobile-navigation {
    display: none;
  }


  /* =========================================
     TABLET
  ========================================= */

  @media (max-width: 1100px) {

    .header-shell {
      gap: 18px;
    }


    .availability-status {
      display: none;
    }


    .nav-link {
      padding-inline: 11px;
    }

  }


  /* =========================================
     MOBILE HEADER
  ========================================= */

  @media (max-width: 800px) {

    .site-header {
      padding: 12px 0;
    }


    .header-shell {
      width: calc(100% - 24px);

      min-height: 60px;

      padding:
        8px
        9px
        8px
        15px;

      border-radius: 16px;
    }


    .brand-logo {
      width: 102px;
    }


    .main-navigation {
      display: none;
    }


    .header-actions {
      gap: 8px;

      margin-left: auto;
    }


    /*
      Mobile Start Building button:
      Text remains visible on mobile.
    */

    .cta-button {
      min-width: auto;

      gap: 7px;

      padding:
        9px
        10px
        9px
        12px;

      border-radius: 9px;

      font-size: 10px;

      letter-spacing: -0.1px;
    }


    .cta-icon {
      width: 22px;
      height: 22px;

      border-radius: 6px;
    }


    .cta-icon svg {
      width: 12px;
      height: 12px;
    }


    .mobile-menu-button {
      display: flex;

      flex-shrink: 0;
    }


    .mobile-navigation {
      position: absolute;

      top: 88px;

      right: 12px;
      left: 12px;

      display: flex;

      flex-direction: column;

      gap: 5px;

      padding: 10px;

      border: 1px solid rgba(255, 255, 255, 0.14);

      border-radius: 16px;

      background:
        rgba(8, 20, 35, 0.94);

      box-shadow:
        0 20px 45px rgba(0, 0, 0, 0.2);

      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);

      opacity: 0;
      visibility: hidden;

      transform: translateY(-12px);

      transition:
        opacity 0.3s ease,
        transform 0.3s ease,
        visibility 0.3s ease;

      pointer-events: none;
    }


    .mobile-navigation.open {
      opacity: 1;

      visibility: visible;

      transform: translateY(0);

      pointer-events: auto;
    }


    .mobile-navigation a {
      padding: 14px;

      border-radius: 10px;

      color: rgba(255, 255, 255, 0.7);

      font-family: Arial, Helvetica, sans-serif;

      font-size: 13px;

      font-weight: 600;

      text-decoration: none;

      transition:
        color 0.25s ease,
        background 0.25s ease;
    }


    .mobile-navigation a:hover,
    .mobile-navigation a.active {
      background:
        rgba(77, 228, 255, 0.1);

      color: #ffffff;
    }

  }


  /* =========================================
     SMALL MOBILE DEVICES
  ========================================= */

  @media (max-width: 430px) {

    .header-shell {
      width: calc(100% - 16px);

      padding-left: 12px;

      padding-right: 8px;
    }


    .brand-logo {
      width: 90px;
    }


    .header-actions {
      gap: 6px;
    }


    .cta-button {
      gap: 5px;

      padding:
        8px
        8px
        8px
        10px;

      font-size: 9px;
    }


    .cta-icon {
      width: 20px;
      height: 20px;

      border-radius: 6px;
    }


    .cta-icon svg {
      width: 11px;
      height: 11px;
    }


    .mobile-menu-button {
      width: 38px;
      height: 38px;

      padding: 9px;
    }


    .mobile-navigation {
      top: 82px;

      right: 8px;
      left: 8px;
    }

  }


  /* =========================================
     ANIMATIONS
  ========================================= */

  @keyframes statusPulse {

    0%,
    100% {
      opacity: 0.5;

      transform: scale(0.9);
    }

    50% {
      opacity: 1;

      transform: scale(1.15);
    }

  }


  /* =========================================
     REDUCED MOTION
  ========================================= */

  @media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;

      animation-iteration-count: 1 !important;

      transition-duration: 0.01ms !important;
    }

  }
</style>


<script>
  const mobileMenuButton = document.querySelector(
    ".mobile-menu-button"
  ) as HTMLButtonElement | null;


  const mobileNavigation = document.querySelector(
    ".mobile-navigation"
  ) as HTMLElement | null;


  const mobileNavigationLinks =
    document.querySelectorAll(
      ".mobile-navigation a"
    );


  function closeMobileMenu() {
    mobileNavigation?.classList.remove("open");

    mobileMenuButton?.setAttribute(
      "aria-expanded",
      "false"
    );

    mobileMenuButton?.setAttribute(
      "aria-label",
      "Open navigation"
    );
  }


  mobileMenuButton?.addEventListener(
    "click",
    () => {

      const isOpen =
        mobileNavigation?.classList.toggle("open") ??
        false;


      mobileMenuButton.setAttribute(
        "aria-expanded",
        String(isOpen)
      );


      mobileMenuButton.setAttribute(
        "aria-label",
        isOpen
          ? "Close navigation"
          : "Open navigation"
      );

    }
  );


  mobileNavigationLinks.forEach(
    (link) => {

      link.addEventListener(
        "click",
        closeMobileMenu
      );

    }
  );


  document.addEventListener(
    "click",
    (event) => {

      const target =
        event.target as Node;


      if (
        mobileNavigation?.classList.contains("open") &&
        !mobileNavigation.contains(target) &&
        !mobileMenuButton?.contains(target)
      ) {
        closeMobileMenu();
      }

    }
  );


  document.addEventListener(
    "keydown",
    (event) => {

      if (event.key === "Escape") {
        closeMobileMenu();
      }

    }
  );


  window.addEventListener(
    "resize",
    () => {

      if (window.innerWidth > 800) {
        closeMobileMenu();
      }

    }
  );
</script>