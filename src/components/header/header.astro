---
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-container">
    <!-- Logo -->
    <a href="/" class="brand" aria-label="SXC Home">
      <img
        src="/images/sxc-logo.png"
        alt="SXC — SintraX Creations"
        class="brand-logo"
      />
    </a>

    <!-- Mobile menu toggle -->
    <input type="checkbox" id="menu-toggle" class="menu-toggle" />

    <label
      for="menu-toggle"
      class="menu-button"
      aria-label="Toggle navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </label>

    <!-- Navigation -->
    <nav class="main-navigation" aria-label="Main navigation">
      <a
        href="/"
        class:list={["nav-link", { active: currentPath === "/" }]}
      >
        Home
      </a>

      <a
        href="/projects"
        class:list={["nav-link", { active: currentPath === "/projects" }]}
      >
        Projects
      </a>

      <a
        href="/benefits"
        class:list={["nav-link", { active: currentPath === "/benefits" }]}
      >
        Benefits
      </a>

      <a
        href="/join"
        class:list={["nav-link", { active: currentPath === "/join" }]}
      >
        Join Now
      </a>
    </nav>

    <!-- Header actions -->
    <div class="header-actions">
      <p class="tagline">
        Ideas <span>|</span> Skills <span>|</span> People <span>|</span> Real
        Impact
      </p>

      <a href="/join" class="join-button">
        <span class="button-text">Join SXC</span>

        <!-- Professional arrow icon -->
        <svg
          class="button-arrow"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M5 12H19M12 5L19 12L12 19"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  /* Header */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    width: 100%;
    padding: 1.2rem 0;
    background: rgba(7, 26, 43, 0.9);
    border-bottom: 1px solid rgba(24, 213, 232, 0.12);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: min(1380px, calc(100% - 5rem));
    min-height: 64px;
    margin: 0 auto;
  }

  /* Logo */
  .brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    width: 126px;
    height: auto;
    object-fit: contain;
    mix-blend-mode: screen;
    transition: transform 0.25s ease;
  }

  .brand:hover .brand-logo {
    transform: scale(1.03);
  }

  /* Desktop navigation */
  .main-navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.25rem;
  }

  .nav-link {
    position: relative;
    padding: 0.65rem 0;
    color: rgba(255, 255, 255, 0.72);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    border-radius: 10px;
    background: #18d5e8;
    content: "";
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #ffffff;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  /* Header actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .tagline {
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .tagline span {
    margin: 0 0.3rem;
    color: #18d5e8;
  }

  /* Join button */
  .join-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-width: 124px;
    padding: 0.85rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: linear-gradient(135deg, #18d5e8, #2f80ed);
    color: #071a2b;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.8rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 8px 24px rgba(24, 213, 232, 0.18);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .button-text {
    line-height: 1;
  }

  /* Professional arrow icon */
  .button-arrow {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    color: #071a2b;
    transition: transform 0.25s ease;
  }

  .join-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(24, 213, 232, 0.35);
  }

  .join-button:hover .button-arrow {
    transform: translateX(3px);
  }

  /* Mobile menu controls */
  .menu-toggle,
  .menu-button {
    display: none;
  }

  /* Smaller desktop screens */
  @media (max-width: 1200px) {
    .header-container {
      width: min(1380px, calc(100% - 3rem));
      gap: 1.5rem;
    }

    .main-navigation {
      gap: 1.35rem;
    }

    .tagline {
      display: none;
    }
  }

  /* Mobile and tablet */
  @media (max-width: 800px) {
    .site-header {
      padding: 0.95rem 0;
    }

    .header-container {
      width: calc(100% - 2rem);
      min-height: 54px;
      gap: 1rem;
    }

    .brand-logo {
      width: 108px;
    }

    .header-actions {
      margin-left: auto;
    }

    .join-button {
      min-width: auto;
      padding: 0.75rem 1rem;
      font-size: 0.75rem;
    }

    .button-arrow {
      width: 18px;
      height: 18px;
    }

    /* Hamburger button */
    .menu-button {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 38px;
      height: 38px;
      padding: 9px;
      border: 1px solid rgba(24, 213, 232, 0.25);
      border-radius: 10px;
      background: rgba(24, 213, 232, 0.08);
      cursor: pointer;
      order: 3;
    }

    .menu-button span {
      display: block;
      width: 100%;
      height: 2px;
      border-radius: 5px;
      background: #ffffff;
      transition:
        transform 0.25s ease,
        opacity 0.25s ease;
    }

    /* Mobile navigation dropdown */
    .main-navigation {
      position: absolute;
      top: calc(100% + 1px);
      right: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.8rem 1rem 1rem;
      border-bottom: 1px solid rgba(24, 213, 232, 0.18);
      background: rgba(7, 26, 43, 0.98);
      box-shadow: 0 18px 35px rgba(0, 0, 0, 0.2);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition:
        opacity 0.25s ease,
        transform 0.25s ease,
        visibility 0.25s ease;
    }

    .nav-link {
      width: 100%;
      padding: 0.95rem 0.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      font-size: 0.85rem;
    }

    .nav-link:last-child {
      border-bottom: none;
    }

    .nav-link::after {
      display: none;
    }

    .menu-toggle:checked ~ .main-navigation {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .menu-toggle:checked ~ .menu-button span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-toggle:checked ~ .menu-button span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle:checked ~ .menu-button span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  /* Very small mobile screens */
  @media (max-width: 420px) {
    .header-container {
      width: calc(100% - 1.25rem);
      gap: 0.65rem;
    }

    .brand-logo {
      width: 96px;
    }

    .join-button {
      padding: 0.7rem 0.8rem;
      font-size: 0.7rem;
      gap: 0.55rem;
    }

    .button-arrow {
      width: 16px;
      height: 16px;
    }

    .menu-button {
      width: 35px;
      height: 35px;
    }
  }
</style>