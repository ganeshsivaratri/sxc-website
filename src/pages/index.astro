---
/* Import reusable SXC components */
import Header from "../components/header/header.astro";
import Hero from "../components/hero/Hero.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Basic character encoding -->
    <meta charset="UTF-8" />

    <!-- Responsive layout -->
    <meta name="viewport" content="width=device-width" />

    <!-- Search engine description -->
    <meta
      name="description"
      content="SintraX Creations — Where students build real products and startup ideas."
    />

    <!-- Browser tab title -->
    <title>SXC | SintraX Creations</title>
  </head>

  <body>
    <!-- Header displayed over the homepage -->
    <Header />

    <!-- Homepage sections -->
    <main>
      <Hero />
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
    background: #071a2b;
    color: #ffffff;
    font-family: Arial, sans-serif;
  }
</style>