---
import Header from "../components/header/header.astro";
import Footer from "../components/footer/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Privacy Policy | SintraX Creations</title>

    <meta
      name="description"
      content="Learn how SintraX Creations collects, uses, stores, and protects student registration information."
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- Privacy Policy Hero -->
      <section class="policy-hero">
        <div class="hero-content">
          <span class="eyebrow">SXC POLICIES</span>

          <h1>Privacy Policy</h1>

          <p>
            Your trust matters to us. This policy explains how SintraX
            Creations handles the information you share with us.
          </p>

          <span class="updated-date">
            Last updated: September 2026
          </span>
        </div>
      </section>

      <!-- Privacy Policy Content -->
      <section class="policy-content">
        <div class="policy-intro">
          <span class="section-label">YOUR PRIVACY</span>

          <h2>How we handle your information</h2>

          <p>
            SintraX Creations values your privacy and aims to handle your
            personal information responsibly. This Privacy Policy explains
            what information we may collect through our registration process,
            why we collect it, and how it may be used.
          </p>
        </div>

        <div class="policy-grid">
          <!-- Section 01 -->
          <article class="policy-card">
            <span class="card-number">01</span>

            <h3>Information We Collect</h3>

            <p>
              When you register with SXC, we may collect information such as:
            </p>

            <ul>
              <li>Full name and email address</li>
              <li>College, branch, section, and year of study</li>
              <li>Register or roll number</li>
              <li>Student and guardian contact details</li>
              <li>Academic information</li>
              <li>Skills, interests, and career goals</li>
              <li>Project ideas and participation preferences</li>
              <li>Other information submitted through our forms</li>
            </ul>
          </article>

          <!-- Section 02 -->
          <article class="policy-card">
            <span class="card-number">02</span>

            <h3>How We Use Your Information</h3>

            <p>
              The information collected may be used for the following
              purposes:
            </p>

            <ul>
              <li>Processing and reviewing student registrations</li>
              <li>Contacting students about SXC activities</li>
              <li>Understanding student interests and skills</li>
              <li>Supporting team formation and project coordination</li>
              <li>Sharing relevant program updates</li>
              <li>Responding to questions and requests</li>
              <li>Improving our programs and student experience</li>
            </ul>
          </article>

          <!-- Section 03 -->
          <article class="policy-card">
            <span class="card-number">03</span>

            <h3>How Information Is Stored</h3>

            <p>
              Our registration process may use Google Forms and Google Sheets
              to collect and organize submitted information.
            </p>

            <p>
              Access to collected information should be limited to people
              responsible for managing registrations, communication, and SXC
              activities.
            </p>

            <p>
              Although we take reasonable steps to handle information
              responsibly, no online system can be guaranteed to be completely
              secure.
            </p>
          </article>

          <!-- Section 04 -->
          <article class="policy-card">
            <span class="card-number">04</span>

            <h3>Information Sharing</h3>

            <p>
              We do not intend to sell your personal information.
            </p>

            <p>
              Information may be shared with relevant SXC team members or
              project coordinators when reasonably necessary to manage
              registration, communication, team formation, or project-related
              activities.
            </p>

            <p>
              Information may also be processed by service providers used for
              registration, communication, or information storage.
            </p>
          </article>

          <!-- Section 05 -->
          <article class="policy-card">
            <span class="card-number">05</span>

            <h3>Communication</h3>

            <p>
              By submitting your registration details, you may be contacted by
              SXC regarding registration updates, program information,
              project-related communication, and next steps.
            </p>

            <p>
              You should provide accurate and active contact information so
              that we can communicate with you effectively.
            </p>
          </article>

          <!-- Section 06 -->
          <article class="policy-card">
            <span class="card-number">06</span>

            <h3>Student and Guardian Information</h3>

            <p>
              If you provide guardian information, you confirm that the
              information has been provided for a legitimate registration or
              communication purpose.
            </p>

            <p>
              Students should avoid submitting unnecessary sensitive personal
              information through our forms or communication channels.
            </p>

            <p>
              If a participant is under 18, appropriate parent or guardian
              involvement may be required where applicable.
            </p>
          </article>

          <!-- Section 07 -->
          <article class="policy-card">
            <span class="card-number">07</span>

            <h3>Data Accuracy and Updates</h3>

            <p>
              You are responsible for providing accurate and up-to-date
              information during registration.
            </p>

            <p>
              If any submitted information is incorrect or needs to be
              updated, you may contact us using the details provided below.
            </p>
          </article>

          <!-- Section 08 -->
          <article class="policy-card">
            <span class="card-number">08</span>

            <h3>Data Retention</h3>

            <p>
              We may retain registration information for as long as reasonably
              necessary for registration management, communication, program
              administration, records, and legitimate operational purposes.
            </p>

            <p>
              The actual retention period may depend on the type of information
              and the purpose for which it was collected.
            </p>
          </article>

          <!-- Section 09 -->
          <article class="policy-card">
            <span class="card-number">09</span>

            <h3>Your Privacy Requests</h3>

            <p>
              You may contact us to ask questions about the personal
              information you have submitted or to request correction of
              inaccurate information.
            </p>

            <p>
              Requests for deletion or other actions will be reviewed based on
              applicable requirements and legitimate operational needs.
            </p>
          </article>

          <!-- Section 10 -->
          <article class="policy-card">
            <span class="card-number">10</span>

            <h3>External Services</h3>

            <p>
              Our website or registration process may use external services
              such as Google Forms, Google Sheets, email services, or
              WhatsApp.
            </p>

            <p>
              These services may process information according to their own
              privacy policies and terms. We recommend reviewing the policies
              of any external service you use.
            </p>
          </article>

          <!-- Section 11 -->
          <article class="policy-card">
            <span class="card-number">11</span>

            <h3>Policy Updates</h3>

            <p>
              We may update this Privacy Policy when our registration process,
              services, or privacy practices change.
            </p>

            <p>
              Any updated version will be published on this page with a
              revised update date.
            </p>
          </article>

          <!-- Section 12 -->
          <article class="policy-card">
            <span class="card-number">12</span>

            <h3>Contact Us</h3>

            <p>
              If you have questions about this Privacy Policy or the handling
              of your information, you can contact SintraX Creations through:
            </p>

            <div class="contact-details">
              <a href="mailto:sintraxcreations@gmail.com">
                sintraxcreations@gmail.com
              </a>

              <a
                href="https://wa.me/919490354451"
                target="_blank"
                rel="noopener noreferrer"
              >
                +91 94903 54451
              </a>
            </div>
          </article>
        </div>

        <!-- Final Notice -->
        <div class="policy-notice">
          <strong>Important Notice</strong>

          <p>
            This Privacy Policy is intended to explain our current information
            practices in a clear manner. It should be reviewed and updated as
            SXC's operations develop and should receive appropriate legal
            review before being relied upon as a formal legal document.
          </p>
        </div>

        <div class="policy-actions">
          <a href="/terms" class="policy-button secondary">
            Terms &amp; Conditions
          </a>

          <a href="/join" class="policy-button primary">
            Return to Registration
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f5f9fc;
    font-family: Arial, Helvetica, sans-serif;
  }

  .policy-hero {
    position: relative;
    overflow: hidden;
    padding: 165px 6% 95px;
    background:
      radial-gradient(
        circle at 80% 20%,
        rgba(24, 213, 232, 0.16),
        transparent 28%
      ),
      linear-gradient(135deg, #04121f, #071a2b);
    color: #ffffff;
  }

  .policy-hero::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(77, 228, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(77, 228, 255, 0.035) 1px, transparent 1px);
    background-size: 45px 45px;
    content: "";
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    width: min(850px, 100%);
    margin: 0 auto;
    text-align: center;
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    color: #18d5e8;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .policy-hero h1 {
    margin: 22px 0 20px;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .policy-hero p {
    max-width: 650px;
    margin: 0 auto;
    color: #b6cbd6;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .updated-date {
    display: inline-block;
    margin-top: 28px;
    color: #7e9baa;
    font-size: 0.82rem;
  }

  .policy-content {
    width: min(1180px, 88%);
    margin: 0 auto;
    padding: 90px 0 100px;
  }

  .policy-intro {
    max-width: 760px;
    margin: 0 auto 55px;
    text-align: center;
  }

  .policy-intro h2 {
    margin: 18px 0;
    color: #071a2b;
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: -0.04em;
  }

  .policy-intro p {
    color: #607786;
    font-size: 1rem;
    line-height: 1.85;
  }

  .policy-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .policy-card {
    padding: 32px;
    border: 1px solid #dce8ef;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 12px 35px rgba(7, 26, 43, 0.045);
  }

  .card-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin-bottom: 22px;
    border-radius: 10px;
    background: #e6fbfe;
    color: #078da0;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .policy-card h3 {
    margin: 0 0 17px;
    color: #071a2b;
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .policy-card p {
    margin: 0 0 14px;
    color: #607786;
    font-size: 0.92rem;
    line-height: 1.8;
  }

  .policy-card p:last-of-type {
    margin-bottom: 0;
  }

  .policy-card ul {
    margin: 0;
    padding-left: 20px;
    color: #607786;
  }

  .policy-card li {
    margin-bottom: 10px;
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .policy-card li:last-child {
    margin-bottom: 0;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-top: 20px;
  }

  .contact-details a {
    color: #078da0;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact-details a:hover {
    color: #071a2b;
  }

  .policy-notice {
    margin-top: 32px;
    padding: 28px 32px;
    border-left: 4px solid #18d5e8;
    border-radius: 12px;
    background: #eaf8fb;
  }

  .policy-notice strong {
    display: block;
    margin-bottom: 10px;
    color: #071a2b;
    font-size: 1rem;
  }

  .policy-notice p {
    margin: 0;
    color: #55717f;
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .policy-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 42px;
  }

  .policy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 13px 23px;
    border-radius: 9px;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .policy-button:hover {
    transform: translateY(-2px);
  }

  .policy-button.primary {
    border: 1px solid #18d5e8;
    background: #18d5e8;
    color: #04121f;
  }

  .policy-button.primary:hover {
    background: #4de4ff;
  }

  .policy-button.secondary {
    border: 1px solid #cbdde5;
    background: #ffffff;
    color: #071a2b;
  }

  .policy-button.secondary:hover {
    border-color: #18d5e8;
  }

  @media (max-width: 800px) {
    .policy-hero {
      padding: 135px 6% 75px;
    }

    .policy-content {
      width: min(92%, 620px);
      padding: 65px 0 75px;
    }

    .policy-grid {
      grid-template-columns: 1fr;
    }

    .policy-card {
      padding: 26px;
    }

    .policy-intro {
      margin-bottom: 38px;
    }
  }

  @media (max-width: 500px) {
    .policy-hero h1 {
      font-size: 2.5rem;
    }

    .policy-hero p {
      font-size: 0.94rem;
    }

    .policy-card {
      padding: 23px;
      border-radius: 14px;
    }

    .policy-notice {
      padding: 23px;
    }

    .policy-actions {
      flex-direction: column;
    }

    .policy-button {
      width: 100%;
    }
  }
</style>