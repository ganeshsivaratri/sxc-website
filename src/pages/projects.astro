---
import ProjectsHero from "../components/projects-hero/ProjectsHero.astro";
import OngoingProjects from "../components/ongoing-projects/OngoingProjects.astro";
import TeamAssigningProjects from "../components/team-assigning-projects/TeamAssigningProjects.astro";
import Header from "../components/header/header.astro";
import Footer from "../components/footer/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>SXC Projects | Sintrax Creations</title>
    <meta
      name="description"
      content="Explore projects being developed by student teams at Sintrax Creations."
    />
  </head>

  <body>
    <Header />

    <main>
      <ProjectsHero />
      <OngoingProjects />
      <TeamAssigningProjects />
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #04121f;
    font-family: Arial, Helvetica, sans-serif;
  }
</style>