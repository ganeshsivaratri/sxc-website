---
import Header from "../components/header/header.astro";
import Footer from "../components/footer/Footer.astro";

const plans = [
  {
    id: "starter",
    number: "01",
    name: "Starter",
    label: "START HERE",
    price: "1,999",
    theme: "cyan",
    headline: "Start with real project experience.",
    description:
      "Build a Mid-Range Project and turn your learning into practical project experience.",
    projectTitle: "1 Mid-Range Project",
    projectDescription:
      "In this plan, you develop one Mid-Range Project. Check the available projects on the Projects page.",
    domainTitle: "No Domain",
    domainDescription: "Portfolio domain is not included in this plan.",
    features: [
      "1 Mid-Range Project",
      "Structured project guidance",
      "Team collaboration",
      "Git & GitHub workflow",
      "Project documentation",
      "Project demonstration",
      "Completion certificate",
    ],
  },

  {
    id: "builder",
    number: "02",
    name: "Builder",
    label: "MOST POPULAR",
    price: "2,999",
    theme: "blue",
    headline: "Build one project that matters.",
    description:
      "Develop one Main Career Project and build stronger practical and portfolio experience.",
    projectTitle: "1 Main Career Project",
    projectDescription:
      "In this plan, you develop one Main Career Project. Check the Career Projects section on the Projects page.",
    domainTitle: "1 Year Domain",
    domainDescription:
      "Portfolio domain included for 1 year.",
    features: [
      "1 Main Career Project",
      "Choose from Career Projects",
      "Structured project mentorship",
      "Team collaboration",
      "Git & GitHub workflow",
      "Project documentation",
      "Portfolio domain for 1 year",
      "Completion certificate",
    ],
  },

  {
    id: "builder-pro",
    number: "03",
    name: "Builder Pro",
    label: "HIGH CAREER VALUE",
    price: "3,999",
    theme: "purple",
    headline: "Build more. Show more.",
    description:
      "Develop one Main Career Project and one Mid-Range Project for broader project experience and higher career value.",
    projectTitle: "Career + Mid-Range",
    projectDescription:
      "In this plan, you develop one Main Career Project and one Mid-Range Project for high career value.",
    domainTitle: "2 Year Domain",
    domainDescription:
      "Portfolio domain included for 2 years.",
    features: [
      "1 Main Career Project",
      "1 Mid-Range Project",
      "Choose from available projects",
      "Structured project mentorship",
      "Team collaboration",
      "Git & GitHub workflow",
      "Portfolio domain for 2 years",
      "Completion certificate",
    ],
  },
];

const technologyRows = [
  {
    label: "BUILD",
    direction: "forward",
    items: [
      { name: "Python", icon: "python" },
      { name: "JavaScript", icon: "javascript" },
      { name: "TypeScript", icon: "typescript" },
      { name: "HTML5", icon: "html5" },
      { name: "CSS3", icon: "css3" },
      { name: "React", icon: "react" },
      { name: "Next.js", icon: "nextdotjs" },
      { name: "Astro", icon: "astro" },
      { name: "Tailwind CSS", icon: "tailwindcss" },
      { name: "Node.js", icon: "nodedotjs" },
    ],
  },
  {
    label: "POWER",
    direction: "reverse",
    items: [
      { name: "FastAPI", icon: "fastapi" },
      { name: "PostgreSQL", icon: "postgresql" },
      { name: "MySQL", icon: "mysql" },
      { name: "MongoDB", icon: "mongodb" },
      { name: "Supabase", icon: "supabase" },
      { name: "Firebase", icon: "firebase" },
      { name: "OpenAI", icon: "openai" },
      { name: "Gemini", icon: "googlegemini" },
      { name: "Claude", icon: "anthropic" },
      { name: "LangChain", icon: "langchain" },
      { name: "n8n", icon: "n8n" },
    ],
  },
  {
    label: "SHIP",
    direction: "forward",
    items: [
      { name: "Git", icon: "git" },
      { name: "GitHub", icon: "github" },
      { name: "GitHub Actions", icon: "githubactions" },
      { name: "Postman", icon: "postman" },
      { name: "Docker", icon: "docker" },
      { name: "Vercel", icon: "vercel" },
      { name: "Render", icon: "render" },
      { name: "Cloudflare", icon: "cloudflare" },
      { name: "REST API", icon: "restapi" },
      { name: "Webhooks", icon: "webhooks" },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Choose your SXC project plan and start building real project experience."
    />

    <title>Pricing | SintraX Creations</title>
  </head>

  <body>
    <Header />

    <main>

      <!-- =====================================================
           HERO
      ====================================================== -->

      <section class="pricing-hero">

        <div class="hero-grid"></div>

        <div class="hero-glow hero-glow-one"></div>
        <div class="hero-glow hero-glow-two"></div>

        <div class="hero-orbit orbit-one"></div>
        <div class="hero-orbit orbit-two"></div>

        <div class="hero-content">

          <div class="hero-tag">
            <span class="tag-dot"></span>
            SXC PROJECT PLANS
          </div>

          <h1>
            Choose how
            <br />
            you want to
            <span>build.</span>
          </h1>

          <p>
            Start with a project, gain real experience,
            and create work you can actually show.
          </p>

          <div class="hero-points">

            <span>REAL PROJECTS</span>

            <i></i>

            <span>GUIDANCE</span>

            <i></i>

            <span>EXPERIENCE</span>

          </div>

        </div>

        <div class="hero-side">
          <span>PRICING</span>
          <strong>01</strong>
        </div>

        <div class="scroll-indicator">
          <span></span>
          SCROLL TO EXPLORE
        </div>

      </section>


      <!-- =====================================================
           INTRO
      ====================================================== -->

      <section class="pricing-intro">

        <div class="intro-container">

          <div class="section-kicker">
            <span></span>
            PICK YOUR BUILDING LEVEL
          </div>

          <div class="intro-content">

            <h2>
              Three plans.
              <br />
              <span>One direction.</span>
            </h2>

            <p>
              Every SXC plan is built around practical project
              experience. Choose the level of project exposure
              that fits your goals.
            </p>

          </div>

        </div>

      </section>


      <!-- =====================================================
           PRICING CARDS
      ====================================================== -->

      <section class="plans-section">

        <div class="plans-container">

          {
            plans.map((plan) => (
              <article
                class:list={[
                  "plan-card",
                  `theme-${plan.theme}`,
                  {
                    featured: plan.id === "builder",
                  },
                ]}
              >

                <div class="card-background"></div>
                <div class="card-shine"></div>

                <div class="card-top-glow"></div>

                <!-- CARD HEADER -->

                <div class="card-header">

                  <div class="card-number">
                    {plan.number}
                  </div>

                  <div class="card-label">
                    {plan.label}
                  </div>

                </div>


                <!-- PLAN TITLE -->

                <div class="plan-title">

                  <div class="title-mini">
                    SXC / PROJECT PLAN
                  </div>

                  <h3>
                    {plan.name}
                  </h3>

                  <div class="title-line"></div>

                </div>


                <!-- PRICE -->

                <div class="price-area">

                  <div class="price-symbol">
                    ₹
                  </div>

                  <div class="price">
                    {plan.price}
                  </div>

                  <div class="price-suffix">
                    /-
                  </div>

                </div>

                <div class="price-caption">
                  ONE-TIME PROJECT PLAN
                </div>


                <!-- HEADLINE -->

                <h4 class="plan-headline">
                  {plan.headline}
                </h4>

                <p class="plan-description">
                  {plan.description}
                </p>


                <!-- PROJECT BOX -->

                <div class="project-box">

                  <div class="project-box-icon">

                    <span></span>
                    <span></span>
                    <span></span>

                  </div>

                  <div class="project-box-content">

                    <div class="box-label">
                      PROJECT INCLUDED
                    </div>

                    <h5>
                      {plan.projectTitle}
                    </h5>

                    <p>
                      {plan.projectDescription}
                    </p>

                    <a href="/projects">
                      VIEW PROJECTS
                      <span>↗</span>
                    </a>

                  </div>

                </div>


                <!-- DOMAIN -->

                <div class="domain-box">

                  <div class="domain-symbol">
                    ◎
                  </div>

                  <div class="domain-content">

                    <div class="box-label">
                      PORTFOLIO DOMAIN
                    </div>

                    <strong>
                      {plan.domainTitle}
                    </strong>

                    <p>
                      {plan.domainDescription}
                    </p>

                    {
                      plan.id !== "starter" && (
                        <small>
                          After the included period: ₹40/month
                        </small>
                      )
                    }

                  </div>

                </div>


                <!-- INCLUDED -->

                <div class="included-section">

                  <div class="included-heading">
                    WHAT YOU GET
                  </div>

                  <div class="feature-list">

                    {
                      plan.features.map((feature, index) => (
                        <div class="feature">

                          <span class="check">
                            ✓
                          </span>

                          <span class="feature-text">
                            {feature}
                          </span>

                        </div>
                      ))
                    }

                  </div>

                </div>


                <!-- CTA -->

                <a
                  href="/join"
                  class="plan-cta"
                >

                  <span>
                    CHOOSE {plan.name.toUpperCase()}
                  </span>

                  <b>
                    →
                  </b>

                </a>

              </article>
            ))
          }

        </div>

      </section>


      <!-- =====================================================
           TECHNOLOGY STACK MARQUEE
      ====================================================== -->

      <section class="tech-section">

        <div class="tech-grid"></div>

        <div class="tech-glow tech-glow-left"></div>
        <div class="tech-glow tech-glow-right"></div>

        <div class="tech-container">

          <div class="tech-heading">

            <div class="section-kicker light">
              <span></span>
              THE SXC TECHNOLOGY STACK
            </div>

            <h2>
              Built with
              <span>real technology.</span>
            </h2>

            <p>
              Explore the technologies across SXC projects —
              from development and AI to databases, automation,
              collaboration and deployment.
            </p>

          </div>


          <div class="tech-marquee">

            {
              technologyRows.map((row, rowIndex) => (
                <div
                  class:list={[
                    "tech-row",
                    row.direction === "reverse"
                      ? "tech-row-reverse"
                      : "",
                  ]}
                >

                  <div class="tech-row-label">
                    <span>
                      0{rowIndex + 1}
                    </span>

                    {row.label}
                  </div>

                  <div class="tech-track-window">

                    <div class="tech-track">

                      {
                        [...row.items, ...row.items].map(
                          (technology) => (
                            <div
                              class="tech-pill"
                              aria-label={technology.name}
                              title={technology.name}
                            >

                              <span class="tech-icon">
                                {
                                  technology.icon === "restapi" ? (
                                    <svg
                                      viewBox="0 0 24 24"
                                      aria-hidden="true"
                                      class="generic-tech-svg"
                                    >
                                      <path
                                        d="M4 6h16M4 12h16M4 18h16"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                      />
                                      <circle cx="8" cy="6" r="1.4" fill="currentColor" />
                                      <circle cx="15" cy="12" r="1.4" fill="currentColor" />
                                      <circle cx="11" cy="18" r="1.4" fill="currentColor" />
                                    </svg>
                                  ) : technology.icon === "webhooks" ? (
                                    <svg
                                      viewBox="0 0 24 24"
                                      aria-hidden="true"
                                      class="generic-tech-svg"
                                    >
                                      <path
                                        d="M7.2 16.8a4.2 4.2 0 1 1 0-8.4h3.2M16.8 7.2a4.2 4.2 0 1 1 0 8.4h-3.2M9 12h6"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                      />
                                      <path
                                        d="m13.5 9.5 2.5 2.5-2.5 2.5"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                      />
                                    </svg>
                                  ) : (
                                    <img
                                      src={`https://cdn.simpleicons.org/${technology.icon}`}
                                      alt=""
                                      aria-hidden="true"
                                      loading="lazy"
                                      decoding="async"
                                    />
                                  )
                                }
                              </span>

                              <span class="tech-name">
                                {technology.name}
                              </span>

                            </div>
                          )
                        )
                      }

                    </div>

                  </div>

                </div>
              ))
            }

          </div>


          <div class="tech-bottom">

            <span></span>

            <p>
              BUILD
              <b>•</b>
              TEST
              <b>•</b>
              COLLABORATE
              <b>•</b>
              DEPLOY
            </p>

            <span></span>

          </div>

        </div>

      </section>


      <!-- =====================================================
           DOMAIN SECTION
      ====================================================== -->

      <section class="domain-section">

        <div class="domain-grid"></div>

        <div class="domain-glow"></div>

        <div class="domain-container">

          <div class="domain-heading">

            <div class="domain-index">
              02
            </div>

            <div>

              <div class="section-kicker light">
                <span></span>
                PORTFOLIO DOMAIN
              </div>

              <h2>
                Build it.
                <br />
                <span>Own your presence.</span>
              </h2>

              <p>
                Higher plans include a portfolio domain so
                your project work can have a place to live
                and be presented professionally.
              </p>

            </div>

          </div>


          <!-- DOMAIN CARDS -->

          <div class="domain-options">

            <div class="domain-option">

              <div class="domain-option-top">

                <span>
                  ₹1,999
                </span>

                <small>
                  STARTER
                </small>

              </div>

              <strong>
                NO DOMAIN
              </strong>

              <p>
                The Starter plan focuses on your
                Mid-Range Project experience.
              </p>

            </div>


            <div class="domain-option active">

              <div class="domain-option-top">

                <span>
                  ₹2,999
                </span>

                <small>
                  BUILDER
                </small>

              </div>

              <strong>
                1 YEAR
              </strong>

              <p>
                Portfolio domain included for one year.
              </p>

            </div>


            <div class="domain-option">

              <div class="domain-option-top">

                <span>
                  ₹3,999
                </span>

                <small>
                  BUILDER PRO
                </small>

              </div>

              <strong>
                2 YEARS
              </strong>

              <p>
                Portfolio domain included for two years.
              </p>

            </div>

          </div>


          <!-- RENEWAL -->

          <div class="domain-renewal">

            <div class="renewal-icon">
              ↻
            </div>

            <div>

              <span>
                AFTER THE INCLUDED DOMAIN PERIOD
              </span>

              <strong>
                ₹40 / MONTH
              </strong>

            </div>

            <p>
              Applies after the included domain period ends.
            </p>

          </div>

        </div>

      </section>


      <!-- =====================================================
           VALUE SECTION
      ====================================================== -->

      <section class="value-section">

        <div class="value-container">

          <div class="value-heading">

            <div class="section-kicker centered">
              <span></span>
              WHAT YOU GET AT SXC
            </div>

            <h2>
              More than
              <span>a project.</span>
            </h2>

            <p>
              The goal is not just to complete something.
              It is to gain experience you can carry forward.
            </p>

          </div>


          <div class="value-grid">

            <div class="value-card">

              <div class="value-number">
                01
              </div>

              <div class="value-icon">
                +
              </div>

              <h3>
                REAL PROJECTS
              </h3>

              <p>
                Build practical software and understand
                how real project work happens.
              </p>

            </div>


            <div class="value-card">

              <div class="value-number">
                02
              </div>

              <div class="value-icon">
                ◈
              </div>

              <h3>
                MENTORSHIP
              </h3>

              <p>
                Receive structured guidance throughout
                your project journey.
              </p>

            </div>


            <div class="value-card">

              <div class="value-number">
                03
              </div>

              <div class="value-icon">
                □
              </div>

              <h3>
                PORTFOLIO
              </h3>

              <p>
                Turn your project work into something
                you can present and showcase.
              </p>

            </div>


            <div class="value-card">

              <div class="value-number">
                04
              </div>

              <div class="value-icon">
                ✓
              </div>

              <h3>
                CERTIFICATE
              </h3>

              <p>
                Receive a completion certificate after
                finishing your project.
              </p>

            </div>

          </div>

        </div>

      </section>


      <!-- =====================================================
           PROJECT SELECTION
      ====================================================== -->

      <section class="selection-section">

        <div class="selection-glow"></div>

        <div class="selection-container">

          <div class="selection-left">

            <div class="section-kicker light">
              <span></span>
              BEFORE YOU JOIN
            </div>

            <h2>
              Know what
              <span>you are choosing.</span>
            </h2>

            <p>
              Explore the SXC Projects page before selecting
              your plan. Understand the available Mid-Range
              and Career Projects and choose accordingly.
            </p>

            <a
              href="/projects"
              class="projects-button"
            >
              EXPLORE PROJECTS
              <span>↗</span>
            </a>

          </div>


          <div class="selection-right">

            <div class="selection-item">

              <div class="selection-number">
                01
              </div>

              <div>

                <h3>
                  STARTER
                </h3>

                <p>
                  1 Mid-Range Project
                </p>

              </div>

            </div>


            <div class="selection-item">

              <div class="selection-number">
                02
              </div>

              <div>

                <h3>
                  BUILDER
                </h3>

                <p>
                  1 Main Career Project
                </p>

              </div>

            </div>


            <div class="selection-item">

              <div class="selection-number">
                03
              </div>

              <div>

                <h3>
                  BUILDER PRO
                </h3>

                <p>
                  1 Main Career Project + 1 Mid-Range Project
                </p>

              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- =====================================================
           FINAL CTA
      ====================================================== -->

      <section class="final-section">

        <div class="final-grid"></div>

        <div class="final-glow"></div>

        <div class="final-content">

          <div class="section-kicker light centered">
            <span></span>
            READY TO BUILD?
          </div>

          <h2>
            Your next project
            <br />
            starts <span>here.</span>
          </h2>

          <p>
            Choose your plan and start your SXC project journey.
          </p>

          <div class="final-buttons">

            <a
              href="/join"
              class="final-primary"
            >
              JOIN NOW
              <span>→</span>
            </a>

            <a
              href="/benefits"
              class="final-secondary"
            >
              SEE BENEFITS
              <span>↗</span>
            </a>

          </div>

          <div class="final-bottom">
            BUILD · LEARN · CREATE · GROW
          </div>

        </div>

      </section>

    </main>

    <Footer />

  </body>
</html>


<style>

  /* =========================================================
     GLOBAL
  ========================================================== */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    overflow-x: hidden;
    background: #ffffff;
    color: #071426;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(a) {
    text-decoration: none;
  }


  /* =========================================================
     HERO
  ========================================================== */

  .pricing-hero {
    position: relative;
    min-height: 610px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 78% 25%,
        rgba(40, 120, 255, 0.23),
        transparent 28%
      ),
      radial-gradient(
        circle at 15% 80%,
        rgba(0, 215, 255, 0.11),
        transparent 25%
      ),
      #050b14;
    color: white;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background-image:
      linear-gradient(
        rgba(255,255,255,0.08) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,0.08) 1px,
        transparent 1px
      );
    background-size: 64px 64px;
    mask-image:
      linear-gradient(
        to bottom,
        black 25%,
        transparent 100%
      );
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(5px);
    animation: floatGlow 8s ease-in-out infinite;
  }

  .hero-glow-one {
    width: 360px;
    height: 360px;
    right: 3%;
    top: -170px;
    background:
      radial-gradient(
        circle,
        rgba(42, 195, 255, 0.23),
        transparent 70%
      );
  }

  .hero-glow-two {
    width: 300px;
    height: 300px;
    left: 4%;
    bottom: -180px;
    background:
      radial-gradient(
        circle,
        rgba(112, 71, 255, 0.15),
        transparent 70%
      );
    animation-delay: -3s;
  }

  .hero-orbit {
    position: absolute;
    border: 1px solid rgba(50,217,255,0.09);
    border-radius: 50%;
    pointer-events: none;
    animation: orbitFloat 12s linear infinite;
  }

  .orbit-one {
    width: 520px;
    height: 520px;
    right: -210px;
    top: -140px;
  }

  .orbit-two {
    width: 350px;
    height: 350px;
    left: -170px;
    bottom: -190px;
    animation-direction: reverse;
    animation-duration: 18s;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width:
      min(1180px, calc(100% - 48px));
    margin: auto;
    padding:
      130px 0 90px;
    animation:
      heroEnter 0.9s ease both;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #32d9ff;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 3px;
  }

  .tag-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #32d9ff;
    box-shadow:
      0 0 14px
      rgba(50,217,255,0.9);
    animation:
      pulseDot 2s infinite;
  }

  .hero-content h1 {
    max-width: 900px;
    margin: 25px 0 0;
    font-size:
      clamp(55px, 8vw, 105px);
    line-height: 0.88;
    letter-spacing: -6px;
    font-weight: 950;
  }

  .hero-content h1 span {
    display: inline-block;
    background:
      linear-gradient(
        90deg,
        #1bdcff,
        #3980ff,
        #9a4cff
      );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      gradientFlow 5s ease infinite;
  }

  .hero-content > p {
    max-width: 590px;
    margin: 30px 0 0;
    color:
      rgba(255,255,255,0.65);
    font-size: 18px;
    line-height: 1.65;
  }

  .hero-points {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 35px;
    color:
      rgba(255,255,255,0.45);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 2.5px;
  }

  .hero-points i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #32d9ff;
  }

  .hero-side {
    position: absolute;
    right: 6%;
    bottom: 65px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color:
      rgba(255,255,255,0.35);
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 3px;
  }

  .hero-side strong {
    color: #32d9ff;
    font-size: 20px;
  }

  .scroll-indicator {
    position: absolute;
    right: 6%;
    bottom: 25px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 9px;
    color: rgba(255,255,255,0.28);
    font-size: 7px;
    font-weight: 900;
    letter-spacing: 2px;
  }

  .scroll-indicator span {
    width: 28px;
    height: 1px;
    background: #32d9ff;
    animation: scrollLine 1.8s ease-in-out infinite;
  }


  /* =========================================================
     INTRO
  ========================================================== */

  .pricing-intro {
    padding:
      105px 24px 55px;
    background: #ffffff;
  }

  .intro-container {
    width:
      min(1180px, 100%);
    margin: auto;
  }

  .section-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #1776d2;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 3px;
  }

  .section-kicker::before {
    content: "";
    width: 25px;
    height: 3px;
    border-radius: 999px;
    background:
      linear-gradient(
        90deg,
        #18d9ff,
        #397aff
      );
  }

  .section-kicker.centered {
    justify-content: center;
  }

  .section-kicker.centered::before {
    display: none;
  }

  .section-kicker.light {
    color: #35d9ff;
  }

  .intro-content {
    display: grid;
    grid-template-columns:
      1fr 0.75fr;
    gap: 100px;
    align-items: end;
    margin-top: 24px;
  }

  .intro-content h2 {
    margin: 0;
    font-size:
      clamp(44px, 5vw, 70px);
    line-height: 0.95;
    letter-spacing: -4px;
    font-weight: 950;
  }

  .intro-content h2 span {
    color: #2563eb;
  }

  .intro-content p {
    max-width: 470px;
    margin: 0;
    color: #64748b;
    font-size: 16px;
    line-height: 1.75;
  }


  /* =========================================================
     PLANS
  ========================================================== */

  .plans-section {
    padding:
      45px 24px 110px;
    background:
      linear-gradient(
        180deg,
        #ffffff 0%,
        #f4f7fb 100%
      );
  }

  .plans-container {
    width:
      min(1280px, 100%);
    margin: auto;
    display: grid;
    grid-template-columns:
      repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 32px;
    overflow: hidden;
    border:
      1px solid #dbe5ef;
    border-radius: 30px;
    background:
      rgba(255,255,255,0.96);
    box-shadow:
      0 12px 45px
      rgba(10,30,60,0.06);
    opacity: 0;
    transform:
      translateY(35px);
    animation:
      cardEnter 0.8s ease forwards;
    transition:
      transform 0.45s ease,
      box-shadow 0.45s ease,
      border-color 0.45s ease;
  }

  .plan-card:nth-child(1) {
    animation-delay: 0.1s;
  }

  .plan-card:nth-child(2) {
    animation-delay: 0.2s;
  }

  .plan-card:nth-child(3) {
    animation-delay: 0.3s;
  }

  .plan-card:hover {
    transform:
      translateY(-12px);
    box-shadow:
      0 30px 80px
      rgba(10,30,60,0.13);
  }

  .plan-card.featured {
    border:
      2px solid
      rgba(40,105,235,0.5);
    box-shadow:
      0 25px 80px
      rgba(37,99,235,0.14);
    transform:
      translateY(-8px);
  }

  .plan-card.featured:hover {
    transform:
      translateY(-20px);
  }

  .card-background {
    position: absolute;
    width: 300px;
    height: 300px;
    top: -190px;
    right: -120px;
    border-radius: 50%;
    filter: blur(25px);
    pointer-events: none;
    transition:
      transform 0.6s ease;
  }

  .plan-card:hover .card-background {
    transform:
      scale(1.3)
      translate(-10px, 20px);
  }

  .theme-cyan .card-background {
    background:
      rgba(18,210,218,0.13);
  }

  .theme-blue .card-background {
    background:
      rgba(37,99,235,0.15);
  }

  .theme-purple .card-background {
    background:
      rgba(125,73,238,0.14);
  }

  .card-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,0.55),
        transparent
      );
    transform:
      skewX(-15deg);
    transition:
      left 0.9s ease;
  }

  .plan-card:hover .card-shine {
    left: 140%;
  }

  .card-top-glow {
    position: absolute;
    width: 130px;
    height: 130px;
    right: -50px;
    top: 70px;
    border-radius: 50%;
    background: rgba(37,99,235,0.06);
    filter: blur(25px);
    pointer-events: none;
  }


  /* =========================================================
     CARD HEADER
  ========================================================== */

  .card-header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }

  .card-number {
    color: #a9b6c5;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 3px;
  }

  .card-label {
    padding:
      8px 12px;
    border-radius: 999px;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 1.5px;
  }

  .theme-cyan .card-label {
    color: #008b96;
    background: #dff9f8;
  }

  .theme-blue .card-label {
    color: #1264c5;
    background: #e4efff;
  }

  .theme-purple .card-label {
    color: #6333c2;
    background: #eee5ff;
  }


  /* =========================================================
     PLAN TITLE
  ========================================================== */

  .plan-title {
    position: relative;
    z-index: 2;
    margin-top: 35px;
  }

  .title-mini {
    color: #9aa9b9;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 2px;
  }

  .plan-title h3 {
    margin: 8px 0 0;
    color: #071426;
    font-size:
      clamp(34px, 3.3vw, 45px);
    line-height: 0.95;
    letter-spacing: -2.5px;
    font-weight: 950;
  }

  .title-line {
    width: 45px;
    height: 4px;
    margin-top: 17px;
    border-radius: 999px;
    background:
      linear-gradient(
        90deg,
        #18d9ff,
        #397aff
      );
  }

  .theme-purple .title-line {
    background:
      linear-gradient(
        90deg,
        #7d45ed,
        #aa63ff
      );
  }


  /* =========================================================
     PRICE
  ========================================================== */

  .price-area {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: baseline;
    margin-top: 30px;
  }

  .price-symbol {
    font-size: 26px;
    font-weight: 900;
  }

  .price {
    margin-left: 3px;
    font-size:
      clamp(58px, 5.4vw, 76px);
    line-height: 0.85;
    letter-spacing: -5px;
    font-weight: 950;
  }

  .theme-cyan .price,
  .theme-cyan .price-symbol {
    color: #0787a0;
  }

  .theme-blue .price,
  .theme-blue .price-symbol {
    color: #1766cf;
  }

  .theme-purple .price,
  .theme-purple .price-symbol {
    color: #6130c2;
  }

  .price-suffix {
    margin-left: 6px;
    color: #78879a;
    font-size: 18px;
    font-weight: 900;
  }

  .price-caption {
    position: relative;
    z-index: 2;
    margin-top: 12px;
    color: #9aa7b5;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 2px;
  }


  /* =========================================================
     DESCRIPTION
  ========================================================== */

  .plan-headline {
    position: relative;
    z-index: 2;
    margin:
      30px 0 0;
    color: #0a1a2e;
    font-size: 18px;
    line-height: 1.35;
    font-weight: 900;
  }

  .plan-description {
    position: relative;
    z-index: 2;
    min-height: 75px;
    margin:
      10px 0 0;
    color: #607086;
    font-size: 15px;
    line-height: 1.7;
  }


  /* =========================================================
     PROJECT BOX
  ========================================================== */

  .project-box {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 16px;
    margin-top: 27px;
    padding: 21px;
    border:
      1px solid #dbe6f1;
    border-radius: 20px;
    background:
      #f4f8fc;
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      background 0.35s ease;
  }

  .plan-card:hover .project-box {
    transform:
      translateY(-3px);
    border-color:
      rgba(37,99,235,0.25);
    background:
      #f1f7fd;
  }

  .project-box-icon {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 9px;
    border-radius: 12px;
    background:
      #071b2e;
    box-shadow:
      0 8px 20px
      rgba(0,25,50,0.12);
  }

  .project-box-icon span {
    width: 100%;
    height: 3px;
    border-radius: 999px;
    background: #2bdcff;
  }

  .project-box-icon span:nth-child(2) {
    width: 72%;
  }

  .project-box-icon span:nth-child(3) {
    width: 48%;
  }

  .box-label {
    color: #8998aa;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 2px;
  }

  .project-box h5 {
    margin:
      6px 0 0;
    color: #102139;
    font-size: 17px;
    line-height: 1.3;
    font-weight: 900;
  }

  .project-box p {
    margin:
      8px 0 0;
    color: #64748b;
    font-size: 13px;
    line-height: 1.6;
  }

  .project-box a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 12px;
    color: #126fd0;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1.5px;
    transition:
      gap 0.25s ease;
  }

  .project-box a:hover {
    gap: 11px;
  }


  /* =========================================================
     DOMAIN BOX
  ========================================================== */

  .domain-box {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 14px;
    margin-top: 13px;
    padding: 17px 19px;
    border:
      1px solid
      rgba(37,99,235,0.13);
    border-radius: 17px;
    background:
      rgba(37,99,235,0.045);
    transition:
      transform 0.3s ease;
  }

  .domain-box:hover {
    transform: translateY(-3px);
  }

  .domain-symbol {
    flex:
      0 0 auto;
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background: #e7f1ff;
    color: #1474d2;
    font-size: 19px;
  }

  .domain-content strong {
    display: block;
    margin-top: 4px;
    color: #17283c;
    font-size: 15px;
    font-weight: 900;
  }

  .domain-content p {
    margin:
      5px 0 0;
    color: #68788b;
    font-size: 12px;
    line-height: 1.5;
  }

  .domain-content small {
    display: block;
    margin-top: 6px;
    color: #1671d3;
    font-size: 11px;
    font-weight: 800;
  }


  /* =========================================================
     FEATURES
  ========================================================== */

  .included-section {
    position: relative;
    z-index: 2;
    margin-top: 28px;
  }

  .included-heading {
    color: #91a0b0;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 2.5px;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 16px;
  }

  .feature {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    color: #24364b;
    font-size: 15px;
    line-height: 1.45;
    transition:
      transform 0.25s ease;
  }

  .feature:hover {
    transform: translateX(4px);
  }

  .check {
    flex:
      0 0 auto;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: -1px;
    border-radius: 50%;
    color: white;
    background: #1473d2;
    font-size: 13px;
    font-weight: 900;
    box-shadow:
      0 5px 14px
      rgba(20,115,210,0.18);
  }

  .theme-cyan .check {
    background: #0ba1aa;
  }

  .theme-purple .check {
    background: #7135d0;
  }

  .feature-text {
    font-weight: 600;
  }


  /* =========================================================
     CTA
  ========================================================== */

  .plan-cta {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 30px;
    padding:
      18px 20px;
    border-radius: 15px;
    color: white;
    background:
      #071b2f;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.5px;
    overflow: hidden;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .plan-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        transparent,
        rgba(255,255,255,0.2),
        transparent
      );
    transform:
      translateX(-120%);
    transition:
      transform 0.7s ease;
  }

  .plan-cta:hover::before {
    transform:
      translateX(120%);
  }

  .plan-cta:hover {
    transform:
      translateY(-3px);
    box-shadow:
      0 15px 35px
      rgba(8,30,55,0.2);
  }

  .theme-cyan .plan-cta {
    background:
      linear-gradient(
        100deg,
        #087f93,
        #08b7c2
      );
  }

  .theme-blue .plan-cta {
    background:
      linear-gradient(
        100deg,
        #155ec0,
        #2c7cf0
      );
  }

  .theme-purple .plan-cta {
    background:
      linear-gradient(
        100deg,
        #5b2bb5,
        #8546dd
      );
  }

  .plan-cta span,
  .plan-cta b {
    position: relative;
    z-index: 2;
  }

  .plan-cta b {
    font-size: 18px;
    transition:
      transform 0.25s ease;
  }

  .plan-cta:hover b {
    transform:
      translateX(5px);
  }


  /* =========================================================
     TECHNOLOGY STACK
  ========================================================== */

  .tech-section {
    position: relative;
    overflow: hidden;
    padding:
      105px 0 95px;
    color: white;
    background:
      radial-gradient(
        circle at 15% 20%,
        rgba(30,200,255,0.10),
        transparent 30%
      ),
      radial-gradient(
        circle at 85% 70%,
        rgba(113,65,255,0.12),
        transparent 32%
      ),
      #050c17;
  }

  .tech-grid {
    position: absolute;
    inset: 0;
    opacity: 0.07;
    background-image:
      linear-gradient(
        rgba(255,255,255,0.12) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,0.12) 1px,
        transparent 1px
      );
    background-size: 55px 55px;
    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 15%,
        black 85%,
        transparent
      );
  }

  .tech-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(90px);
  }

  .tech-glow-left {
    width: 300px;
    height: 300px;
    left: -170px;
    top: 30%;
    background:
      rgba(21,205,255,0.11);
  }

  .tech-glow-right {
    width: 350px;
    height: 350px;
    right: -180px;
    bottom: 5%;
    background:
      rgba(112,66,255,0.12);
  }

  .tech-container {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .tech-heading {
    width:
      min(1180px, calc(100% - 48px));
    margin: auto;
    text-align: center;
  }

  .tech-heading .section-kicker {
    justify-content: center;
  }

  .tech-heading .section-kicker::before {
    display: none;
  }

  .tech-heading h2 {
    margin:
      20px 0 0;
    font-size:
      clamp(42px, 5.5vw, 70px);
    line-height: 0.95;
    letter-spacing: -4px;
    font-weight: 950;
  }

  .tech-heading h2 span {
    display: inline-block;
    background:
      linear-gradient(
        90deg,
        #20dfff,
        #4086ff,
        #a14dff
      );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      gradientFlow 5s ease infinite;
  }

  .tech-heading > p {
    max-width: 650px;
    margin:
      22px auto 0;
    color:
      rgba(255,255,255,0.50);
    font-size: 15px;
    line-height: 1.75;
  }

  .tech-marquee {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 65px;
  }

  .tech-row {
    position: relative;
    display: grid;
    grid-template-columns:
      95px 1fr;
    align-items: center;
    gap: 20px;
  }

  .tech-row-label {
    position: relative;
    z-index: 5;
    padding-left:
      max(24px, calc((100vw - 1180px) / 2));
    color: #ffffff;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
    white-space: nowrap;
  }

  .tech-row-label span {
    display: block;
    margin-bottom: 7px;
    color: #36d9ff;
    font-size: 8px;
    letter-spacing: 3px;
  }

  .tech-track-window {
    position: relative;
    overflow: hidden;
    width: 100%;
    mask-image:
      linear-gradient(
        90deg,
        transparent 0%,
        black 5%,
        black 95%,
        transparent 100%
      );
    -webkit-mask-image:
      linear-gradient(
        90deg,
        transparent 0%,
        black 5%,
        black 95%,
        transparent 100%
      );
  }

  .tech-track {
    display: flex;
    align-items: center;
    gap: 13px;
    width: max-content;
    animation:
      marqueeForward 32s linear infinite;
  }

  .tech-row-reverse .tech-track {
    animation-name:
      marqueeReverse;
    animation-duration: 36s;
  }

  .tech-row:hover .tech-track {
    animation-play-state: paused;
  }

  .tech-pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: max-content;
    padding:
      14px 20px;
    border:
      1px solid
      rgba(255,255,255,0.10);
    border-radius: 999px;
    color:
      rgba(255,255,255,0.82);
    background:
      rgba(255,255,255,0.045);
    box-shadow:
      inset 0 1px 0
      rgba(255,255,255,0.06);
    backdrop-filter: blur(12px);
    font-size: 13px;
    font-weight: 750;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease,
      color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .tech-pill:hover {
    transform:
      translateY(-5px)
      scale(1.04);
    border-color:
      rgba(50,217,255,0.42);
    color: white;
    background:
      rgba(40,170,255,0.10);
    box-shadow:
      0 12px 35px
      rgba(20,170,255,0.13);
  }

  .tech-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
    border:
      1px solid
      rgba(50,217,255,0.22);
    border-radius: 9px;
    color: #39dfff;
    background:
      rgba(26,211,255,0.08);
    overflow: hidden;
  }

  .tech-icon img,
  .generic-tech-svg {
    width: 18px;
    height: 18px;
    display: block;
    object-fit: contain;
  }

  .tech-icon img {
    filter:
      brightness(0)
      saturate(100%)
      invert(84%)
      sepia(24%)
      saturate(1872%)
      hue-rotate(152deg)
      brightness(103%)
      contrast(102%);
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
  }

  .tech-pill:hover .tech-icon img,
  .tech-pill:hover .generic-tech-svg {
    transform: scale(1.12);
    filter: none;
  }

  .tech-name {
    white-space: nowrap;
  }

  .tech-row:nth-child(2) .tech-icon {
    color: #74a5ff;
    border-color:
      rgba(92,132,255,0.24);
    background:
      rgba(77,111,255,0.08);
  }

  .tech-row:nth-child(3) .tech-icon {
    color: #b278ff;
    border-color:
      rgba(164,95,255,0.24);
    background:
      rgba(143,73,255,0.08);
  }

  .tech-bottom {
    width:
      min(760px, calc(100% - 48px));
    margin:
      55px auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }

  .tech-bottom span {
    width: 70px;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(49,217,255,0.55)
      );
  }

  .tech-bottom span:last-child {
    background:
      linear-gradient(
        90deg,
        rgba(143,73,255,0.55),
        transparent
      );
  }

  .tech-bottom p {
    margin: 0;
    color:
      rgba(255,255,255,0.32);
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 3px;
    white-space: nowrap;
  }

  .tech-bottom b {
    margin: 0 7px;
    color: #32d9ff;
  }


  /* =========================================================
     DOMAIN SECTION
  ========================================================== */

  .domain-section {
    position: relative;
    overflow: hidden;
    padding:
      110px 24px;
    color: white;
    background:
      radial-gradient(
        circle at 80% 20%,
        rgba(37,99,235,0.22),
        transparent 28%
      ),
      #061724;
  }

  .domain-grid {
    position: absolute;
    inset: 0;
    opacity: 0.08;
    background-image:
      linear-gradient(
        rgba(255,255,255,0.1) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,0.1) 1px,
        transparent 1px
      );
    background-size: 60px 60px;
  }

  .domain-glow {
    position: absolute;
    width: 450px;
    height: 450px;
    right: -180px;
    top: -230px;
    border-radius: 50%;
    background:
      rgba(25,194,255,0.12);
    filter: blur(80px);
    animation:
      floatGlow 9s ease-in-out infinite;
  }

  .domain-container {
    position: relative;
    z-index: 2;
    width:
      min(1180px, 100%);
    margin: auto;
  }

  .domain-heading {
    display: grid;
    grid-template-columns:
      60px 1fr;
    gap: 20px;
  }

  .domain-index {
    color: #35d9ff;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 3px;
  }

  .domain-heading h2 {
    margin:
      18px 0 0;
    font-size:
      clamp(44px, 5vw, 68px);
    line-height: 0.94;
    letter-spacing: -4px;
    font-weight: 950;
  }

  .domain-heading h2 span {
    color: #35d9ff;
  }

  .domain-heading p {
    max-width: 540px;
    margin-top: 20px;
    color:
      rgba(255,255,255,0.55);
    font-size: 14px;
    line-height: 1.7;
  }


  /* =========================================================
     DOMAIN OPTIONS
  ========================================================== */

  .domain-options {
    display: grid;
    grid-template-columns:
      repeat(3, 1fr);
    gap: 14px;
    margin-top: 60px;
  }

  .domain-option {
    padding: 25px;
    border:
      1px solid
      rgba(255,255,255,0.11);
    border-radius: 20px;
    background:
      rgba(255,255,255,0.035);
    transition:
      transform 0.3s ease,
      background 0.3s ease,
      border-color 0.3s ease;
  }

  .domain-option:hover,
  .domain-option.active {
    transform:
      translateY(-6px);
    border-color:
      rgba(48,216,255,0.35);
    background:
      rgba(48,216,255,0.06);
  }

  .domain-option-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }

  .domain-option-top span {
    color: #36d9ff;
    font-size: 14px;
    font-weight: 900;
  }

  .domain-option-top small {
    color:
      rgba(255,255,255,0.35);
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 1.5px;
  }

  .domain-option strong {
    display: block;
    margin-top: 24px;
    color: white;
    font-size: 22px;
    font-weight: 950;
  }

  .domain-option p {
    margin:
      9px 0 0;
    color:
      rgba(255,255,255,0.48);
    font-size: 12px;
    line-height: 1.6;
  }


  /* =========================================================
     DOMAIN RENEWAL
  ========================================================== */

  .domain-renewal {
    display: grid;
    grid-template-columns:
      auto auto 1fr;
    align-items: center;
    gap: 20px;
    margin-top: 18px;
    padding:
      22px 25px;
    border:
      1px solid
      rgba(47,216,255,0.2);
    border-radius: 18px;
    background:
      rgba(32,206,255,0.045);
  }

  .renewal-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: #36d9ff;
    background:
      rgba(49,217,255,0.09);
    font-size: 22px;
    animation:
      rotateSlow 8s linear infinite;
  }

  .domain-renewal span {
    display: block;
    color:
      rgba(255,255,255,0.4);
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 2px;
  }

  .domain-renewal strong {
    display: block;
    margin-top: 4px;
    color: #36d9ff;
    font-size: 22px;
    font-weight: 950;
  }

  .domain-renewal p {
    margin: 0;
    color:
      rgba(255,255,255,0.46);
    font-size: 11px;
  }


  /* =========================================================
     VALUE
  ========================================================== */

  .value-section {
    padding:
      110px 24px;
    background: white;
  }

  .value-container {
    width:
      min(1180px, 100%);
    margin: auto;
  }

  .value-heading {
    text-align: center;
  }

  .value-heading h2 {
    margin:
      18px 0 0;
    font-size:
      clamp(44px, 5vw, 68px);
    line-height: 0.95;
    letter-spacing: -4px;
    font-weight: 950;
  }

  .value-heading h2 span {
    color: #2563eb;
  }

  .value-heading > p {
    max-width: 550px;
    margin:
      18px auto 0;
    color: #68788c;
    font-size: 14px;
    line-height: 1.7;
  }

  .value-grid {
    display: grid;
    grid-template-columns:
      repeat(4, 1fr);
    margin-top: 60px;
    border-top:
      1px solid #dce5ee;
    border-bottom:
      1px solid #dce5ee;
  }

  .value-card {
    min-height: 250px;
    padding:
      32px 25px;
    border-right:
      1px solid #dce5ee;
    transition:
      transform 0.35s ease,
      background 0.35s ease;
  }

  .value-card:last-child {
    border-right: none;
  }

  .value-card:hover {
    transform:
      translateY(-5px);
    background: #f7faff;
  }

  .value-number {
    color: #b0bdca;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 2px;
  }

  .value-icon {
    margin-top: 30px;
    color: #1676d3;
    font-size: 29px;
    font-weight: 900;
  }

  .value-card h3 {
    margin:
      16px 0 0;
    color: #0b1b30;
    font-size: 15px;
    font-weight: 950;
    letter-spacing: 0.5px;
  }

  .value-card p {
    max-width: 210px;
    margin:
      10px 0 0;
    color: #66768a;
    font-size: 13px;
    line-height: 1.65;
  }


  /* =========================================================
     SELECTION
  ========================================================== */

  .selection-section {
    position: relative;
    overflow: hidden;
    padding:
      110px 24px;
    color: white;
    background: #061a31;
  }

  .selection-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    right: -200px;
    top: -250px;
    border-radius: 50%;
    background:
      rgba(35,145,255,0.14);
    filter: blur(80px);
    animation:
      floatGlow 8s ease-in-out infinite;
  }

  .selection-container {
    position: relative;
    z-index: 2;
    width:
      min(1180px, 100%);
    margin: auto;
    display: grid;
    grid-template-columns:
      0.9fr 1.1fr;
    gap: 90px;
    align-items: center;
  }

  .selection-left h2 {
    margin:
      18px 0 0;
    font-size:
      clamp(44px, 5vw, 68px);
    line-height: 0.95;
    letter-spacing: -4px;
    font-weight: 950;
  }

  .selection-left h2 span {
    color: #32d9ff;
  }

  .selection-left p {
    max-width: 490px;
    margin-top: 22px;
    color:
      rgba(255,255,255,0.55);
    font-size: 14px;
    line-height: 1.75;
  }

  .projects-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    padding:
      14px 18px;
    border:
      1px solid
      rgba(50,217,255,0.3);
    border-radius: 999px;
    color: #32d9ff;
    background:
      rgba(50,217,255,0.06);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1.5px;
    transition:
      transform 0.3s ease,
      gap 0.3s ease,
      background 0.3s ease;
  }

  .projects-button:hover {
    transform:
      translateY(-3px);
    gap: 17px;
    background:
      rgba(50,217,255,0.12);
  }

  .selection-right {
    border-top:
      1px solid
      rgba(255,255,255,0.13);
    border-bottom:
      1px solid
      rgba(255,255,255,0.13);
  }

  .selection-item {
    display: grid;
    grid-template-columns:
      55px 1fr;
    gap: 15px;
    padding:
      28px 0;
    border-bottom:
      1px solid
      rgba(255,255,255,0.1);
    transition:
      padding-left 0.3s ease;
  }

  .selection-item:last-child {
    border-bottom: none;
  }

  .selection-item:hover {
    padding-left: 8px;
  }

  .selection-number {
    color: #32d9ff;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 2px;
  }

  .selection-item h3 {
    margin: 0;
    color: white;
    font-size: 16px;
    font-weight: 900;
  }

  .selection-item p {
    margin:
      7px 0 0;
    color:
      rgba(255,255,255,0.48);
    font-size: 13px;
  }


  /* =========================================================
     FINAL CTA
  ========================================================== */

  .final-section {
    position: relative;
    overflow: hidden;
    padding:
      125px 24px;
    text-align: center;
    color: white;
    background:
      radial-gradient(
        circle at 50% 0,
        rgba(37,99,235,0.24),
        transparent 35%
      ),
      #050b14;
  }

  .final-grid {
    position: absolute;
    inset: 0;
    opacity: 0.07;
    background-image:
      linear-gradient(
        rgba(255,255,255,0.1) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,0.1) 1px,
        transparent 1px
      );
    background-size: 60px 60px;
  }

  .final-glow {
    position: absolute;
    width: 450px;
    height: 220px;
    left: 50%;
    top: -100px;
    transform:
      translateX(-50%);
    border-radius: 50%;
    background:
      rgba(32,205,255,0.12);
    filter: blur(70px);
    animation:
      floatGlow 7s ease-in-out infinite;
  }

  .final-content {
    position: relative;
    z-index: 2;
  }

  .final-content h2 {
    margin:
      20px 0 0;
    font-size:
      clamp(50px, 6vw, 80px);
    line-height: 0.94;
    letter-spacing: -5px;
    font-weight: 950;
  }

  .final-content h2 span {
    background:
      linear-gradient(
        90deg,
        #16d9ff,
        #3c7cff,
        #a34eff
      );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      gradientFlow 5s ease infinite;
  }

  .final-content > p {
    margin-top: 22px;
    color:
      rgba(255,255,255,0.5);
    font-size: 15px;
  }

  .final-buttons {
    display: flex;
    justify-content: center;
    gap: 13px;
    margin-top: 36px;
  }

  .final-primary,
  .final-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    min-width: 180px;
    padding:
      16px 21px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.5px;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .final-primary {
    color: #06111e;
    background:
      linear-gradient(
        100deg,
        #17d9ff,
        #9b4dff
      );
  }

  .final-secondary {
    color: white;
    border:
      1px solid
      rgba(255,255,255,0.2);
    background:
      rgba(255,255,255,0.05);
  }

  .final-primary:hover,
  .final-secondary:hover {
    transform:
      translateY(-4px);
    box-shadow:
      0 18px 45px
      rgba(0,0,0,0.25);
  }

  .final-bottom {
    margin-top: 50px;
    color:
      rgba(255,255,255,0.25);
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 4px;
  }


  /* =========================================================
     ANIMATIONS
  ========================================================== */

  @keyframes heroEnter {
    from {
      opacity: 0;
      transform:
        translateY(30px);
    }

    to {
      opacity: 1;
      transform:
        translateY(0);
    }
  }

  @keyframes cardEnter {
    from {
      opacity: 0;
      transform:
        translateY(35px);
    }

    to {
      opacity: 1;
      transform:
        translateY(0);
    }
  }

  @keyframes pulseDot {
    0%,
    100% {
      opacity: 0.5;
      transform:
        scale(0.85);
    }

    50% {
      opacity: 1;
      transform:
        scale(1.2);
    }
  }

  @keyframes floatGlow {
    0%,
    100% {
      transform:
        translate3d(0,0,0);
    }

    50% {
      transform:
        translate3d(0,22px,0);
    }
  }

  @keyframes orbitFloat {
    from {
      transform:
        rotate(0deg);
    }

    to {
      transform:
        rotate(360deg);
    }
  }

  @keyframes rotateSlow {
    from {
      transform:
        rotate(0deg);
    }

    to {
      transform:
        rotate(360deg);
    }
  }

  @keyframes gradientFlow {
    0% {
      background-position:
        0% 50%;
    }

    50% {
      background-position:
        100% 50%;
    }

    100% {
      background-position:
        0% 50%;
    }
  }

  @keyframes scrollLine {
    0%,
    100% {
      opacity: 0.3;
      transform:
        scaleX(0.65);
      transform-origin: left;
    }

    50% {
      opacity: 1;
      transform:
        scaleX(1);
      transform-origin: left;
    }
  }

  @keyframes marqueeForward {
    from {
      transform:
        translateX(0);
    }

    to {
      transform:
        translateX(-50%);
    }
  }

  @keyframes marqueeReverse {
    from {
      transform:
        translateX(-50%);
    }

    to {
      transform:
        translateX(0);
    }
  }


  /* =========================================================
     TABLET
  ========================================================== */

  @media (max-width: 1050px) {

    .plans-container {
      grid-template-columns:
        1fr;
      width:
        min(680px, 100%);
    }

    .plan-card {
      padding: 32px;
    }

    .plan-card.featured,
    .plan-card.featured:hover {
      transform:
        translateY(0);
    }

    .intro-content {
      grid-template-columns:
        1fr;
      gap: 25px;
    }

    .tech-row {
      grid-template-columns:
        70px 1fr;
    }

    .tech-row-label {
      padding-left: 24px;
    }

    .domain-options {
      grid-template-columns:
        1fr;
    }

    .domain-option {
      padding: 22px;
    }

    .domain-renewal {
      grid-template-columns:
        auto 1fr;
    }

    .domain-renewal p {
